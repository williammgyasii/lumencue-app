<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <RootNamespace>ChurchProjection.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>LumenCue</Product>
    <AssemblyTitle>LumenCue</AssemblyTitle>
    <Company>LumenCue</Company>
    <Version>0.7.25</Version>
    <FileVersion>0.7.25</FileVersion>
    <InformationalVersion>0.7.25</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.8" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.8" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
    <!-- Pin patched transitive dependency (Avalonia pulls 0.21.2; 0.21.3 backports the GHSA-xrw6-gwf8-vvr9 fix). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.6" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChurchProjection.Core\ChurchProjection.Core.csproj" />
    <ProjectReference Include="..\ChurchProjection.Infrastructure\ChurchProjection.Infrastructure.csproj" />
    <ProjectReference Include="..\ChurchProjection.UI\ChurchProjection.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!--
      appsettings.local.json holds developer-only overrides/secrets and MUST NOT ship.
      It is copied for local Debug runs only; Release/Publish (the installer) never bundles it,
      so no secrets ever leave the build machine.
    -->
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('appsettings.local.json') And '$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) AND Exists('/Library/NDI SDK for Apple/lib/macOS/libndi.dylib')">
    <Content Include="/Library/NDI SDK for Apple/lib/macOS/libndi.dylib" Link="libNDILib.dylib" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="/Library/NDI SDK for Apple/lib/macOS/libndi.dylib" Link="NDILib.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    LumenCue ships win-x64 only, but native packages (e.g. Microsoft.ML.OnnxRuntime for the
    semantic matcher) bundle binaries for every OS/arch under runtimes\*. Strip the ones we
    never load so the published build / installer stays lean.
  -->
  <Target Name="TrimForeignNativeRuntimes" AfterTargets="Publish">
    <ItemGroup>
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\linux-arm" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\linux-arm64" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\linux-x64" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\linux-x86" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\linux-musl-x64" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\osx" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\osx-arm64" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\osx-x64" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\macos-arm64" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\macos-x64" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\win-arm64" />
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\win-x86" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignRuntimeDir)" />
    <!-- macOS Metal shader for Whisper; unused on Windows. -->
    <Delete Files="$(PublishDir)ggml-metal.metal" Condition="Exists('$(PublishDir)ggml-metal.metal')" />
  </Target>

</Project>
