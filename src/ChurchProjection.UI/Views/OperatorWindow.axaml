<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChurchProjection.UI.ViewModels"
        xmlns:views="using:ChurchProjection.UI.Views"
        xmlns:content="using:ChurchProjection.Core.Models.Content"
        xmlns:svc="using:ChurchProjection.Core.Services"
        xmlns:op="using:ChurchProjection.UI.ViewModels.Operator"
        xmlns:slides="using:ChurchProjection.Core.Models.Slides"
        xmlns:proj="using:ChurchProjection.Core.Models.Projection"
        xmlns:uisvc="using:ChurchProjection.UI.Services"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="ChurchProjection.UI.Views.OperatorWindow"
        x:DataType="vm:OperatorViewModel"
        Title="LumenCue"
        Icon="/Assets/app-icon.png"
        Width="1400" Height="900"
        MinWidth="1100" MinHeight="700"
        CanResize="True"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="#0E1014">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#181C24" />
      <Setter Property="Foreground" Value="#ECEEF2" />
      <Setter Property="BorderBrush" Value="#3C4350" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#7C6CF6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C6CF6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#6A59E8" />
    </Style>
    <Style Selector="Button.transition">
      <Setter Property="Background" Value="#7C6CF6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.transition:pointerover">
      <Setter Property="Background" Value="#6A59E8" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A7AFBC" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#232932" />
    </Style>
    <!-- Prominent, centered top-bar navigation (Songs / Themes) -->
    <Style Selector="Button.topNav">
      <Setter Property="Background" Value="#1B202A" />
      <Setter Property="BorderBrush" Value="#2A303C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value="{x:Static svc:OperatorWorkspaceChrome.InactiveOpacity}" />
    </Style>
    <Style Selector="Button.topNav:pointerover">
      <Setter Property="Background" Value="#262446" />
      <Setter Property="BorderBrush" Value="#7C6CF6" />
    </Style>
    <Style Selector="Button.topNav.active">
      <Setter Property="Opacity" Value="{x:Static svc:OperatorWorkspaceChrome.ActiveOpacity}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.topNav.bible.active">
      <Setter Property="Background" Value="#11324A" />
      <Setter Property="BorderBrush" Value="#38BDF8" />
    </Style>
    <Style Selector="Button.topNav.songs.active">
      <Setter Property="Background" Value="#2A2444" />
      <Setter Property="BorderBrush" Value="#A78BFA" />
    </Style>
    <Style Selector="Button.topNav.media.active">
      <Setter Property="Background" Value="#0E3A40" />
      <Setter Property="BorderBrush" Value="#22D3EE" />
    </Style>
    <Style Selector="Button.topNav.notes.active">
      <Setter Property="Background" Value="#3A2A12" />
      <Setter Property="BorderBrush" Value="#FBBF24" />
    </Style>
    <Style Selector="Button.topNav.themeNav">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.queueBtn">
      <Setter Property="Background" Value="#2A303C" />
      <Setter Property="Foreground" Value="#D8DCE3" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.queueBtn:pointerover">
      <Setter Property="Background" Value="#3C4350" />
    </Style>
    <Style Selector="Button.iconBtn Path">
      <Setter Property="Fill" Value="#D8DCE3" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <!-- Compact on/off — Fluent ToggleSwitch has a wide On/Off content slot and will not
         shrink, so it overlaps neighbors. This is a fixed 40×22 track. -->
    <Style Selector="ToggleButton.compactSwitch">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="#3C4350">
            <Panel>
              <Ellipse x:Name="knobOff" Width="16" Height="16" Fill="#ECEEF2"
                       HorizontalAlignment="Left" Margin="3,0" />
              <Ellipse x:Name="knobOn" Width="16" Height="16" Fill="#0E1014"
                       HorizontalAlignment="Right" Margin="3,0" IsVisible="False" />
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.compactSwitch:checked /template/ Border#track">
      <Setter Property="Background" Value="#22C55E" />
    </Style>
    <Style Selector="ToggleButton.compactSwitch:checked /template/ Ellipse#knobOff">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.compactSwitch:checked /template/ Ellipse#knobOn">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Background palette tile -->
    <Style Selector="Border.bgTile">
      <Setter Property="Width" Value="118" />
      <Setter Property="Height" Value="66" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Black" />
      <Setter Property="BorderBrush" Value="#2A303C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.bgTile:pointerover">
      <Setter Property="BorderBrush" Value="#5A6478" />
    </Style>
    <Style Selector="Border.bgTile.selected">
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="#11151B" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="#7C6CF6" />
    </Style>
    <!-- Persistent update toast: gently pulses to stay noticeable until the user updates. -->
    <Style Selector="Border.updateToast">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

    <!-- TOP TOOLBAR — system title bar above this handles move / resize / min / max / close. -->
    <Border Grid.Row="0" Background="#14181F" Padding="16,9" BorderBrush="#2A303C" BorderThickness="0,0,0,1"
            ClipToBounds="True">
      <Grid ColumnDefinitions="Auto,*,Auto" ClipToBounds="True">
        <!-- LEFT: logo + optional subscription banner -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" ClipToBounds="True">
            <Image Source="/Assets/logo.png" Width="28" Height="28" Stretch="UniformToFill" />
          </Border>
          <TextBlock Classes="h2" Text="LumenCue" Foreground="#ECEEF2" FontSize="16" VerticalAlignment="Center"
                     Margin="0,0,4,0" />
          <Border Background="#3A2A12" CornerRadius="10" Padding="10,4" IsVisible="{Binding ShowEntitlementBanner}"
                  ToolTip.Tip="Subscription status">
            <TextBlock Text="{Binding EntitlementBannerText}" Foreground="#F59E0B" FontSize="11"
                       MaxWidth="300" TextTrimming="CharacterEllipsis" />
          </Border>
        </StackPanel>

        <!-- CENTER: workspace modes — scrolls horizontally when the window is narrow. -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      MinWidth="0" Margin="8,0">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- Bible mode -->
          <Button Classes="topNav bible" Classes.active="{Binding IsBibleMode}"
                  Command="{Binding ShowBibleModeCommand}"
                  ToolTip.Tip="Scripture mode: search verses, AI suggestions and bookmarks">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="BookOpenPageVariant" Width="18" Height="18" Foreground="#38BDF8" />
              <TextBlock Text="Bible" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Songs mode -->
          <Button Classes="topNav songs" Classes.active="{Binding IsSongsMode}"
                  Command="{Binding ShowSongsModeCommand}"
                  ToolTip.Tip="Songs mode: smart lyric search and your song library">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="MusicNote" Width="18" Height="18" Foreground="#A78BFA" />
              <TextBlock Text="Songs" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Media mode: graphics + videos with transport, sent live per channel -->
          <Button Classes="topNav media" Classes.active="{Binding IsMediaMode}"
                  Command="{Binding ShowMediaModeCommand}"
                  ToolTip.Tip="Media: send full-screen / lower-third graphics and videos (with sound) per channel">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="PlayBoxOutline" Width="18" Height="18" Foreground="#22D3EE" />
              <TextBlock Text="Media" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Notes (own workspace, not a Bible tab) -->
          <Button Classes="topNav notes" Classes.active="{Binding IsNotesMode}"
                  Command="{Binding ShowNotesTabCommand}"
                  ToolTip.Tip="Notes: prayer points and announcements">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="NoteTextOutline" Width="18" Height="18" Foreground="#FBBF24" />
              <TextBlock Text="Notes" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Themes (opens the Theme Studio dialog) -->
          <Button Classes="topNav themeNav" Tapped="OnThemeStudioClicked"
                  ToolTip.Tip="{x:Static svc:OwnerDialogTooltips.ThemesTip}">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="#F472B6" />
              <TextBlock Text="Themes" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: Output + cog on one baseline (StackPanel = row, like flex align-items: center). -->
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12"
                    VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                      ToolTip.Tip="Master screen output. Off hides projector windows so the physical display reverts to the desktop or another source — different from Blank, which stays live but shows black.">
            <TextBlock Text="Output" FontSize="12" Foreground="#A7AFBC" VerticalAlignment="Center" />
            <ToggleButton Classes="compactSwitch" IsChecked="{Binding ScreenOutputEnabled}" />
          </StackPanel>
          <Button Classes="ghost" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                  Click="OnSettingsClicked" ToolTip.Tip="{x:Static svc:OwnerDialogTooltips.SettingsTip}">
            <icons:MaterialIcon Kind="Cog" Width="18" Height="18" Foreground="#D8DCE3" />
          </Button>
          <Button Content="Sign in" Command="{Binding SignInCommand}" IsVisible="{Binding !IsSignedIn}"
                  Background="#0E4A6E" Foreground="#7DD3FC" FontWeight="SemiBold"
                  FontSize="12" Padding="14,6" CornerRadius="6" VerticalAlignment="Center"
                  ToolTip.Tip="Sign in to sync your library and unlock cloud features">
            <Button.Styles>
              <Style Selector="Button:pointerover">
                <Setter Property="Background" Value="#155E8A" />
              </Style>
            </Button.Styles>
          </Button>
          <Button Classes="ghost" Content="Upgrade" Command="{Binding UpgradeCommand}"
                  IsVisible="{Binding ShowUpgrade}" FontSize="12" Padding="10,6" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- MAIN: navigator (left) | content (center) | Program (right). Widths are fixed so the center grid stays flush. -->
    <Grid x:Name="MainSplitGrid" Grid.Row="1" Margin="14,12,8,8" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: ProPresenter-style navigator — collapsible Library + Playlists sections -->
        <Border Grid.Column="0" Background="#181C24" CornerRadius="10" BorderBrush="#2A303C" BorderThickness="1" ClipToBounds="True">
          <Border.Styles>
            <!-- Section header row -->
            <Style Selector="Border.sectionHeader">
              <Setter Property="Background" Value="#1B202A" />
              <Setter Property="Padding" Value="12,7" />
            </Style>
            <Style Selector="TextBlock.sectionLabel">
              <Setter Property="FontSize" Value="10" />
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="Foreground" Value="#8A92A0" />
              <Setter Property="LetterSpacing" Value="1.2" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.hdrIcon">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="#8A92A0" />
              <Setter Property="Padding" Value="5,2" />
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.hdrIcon:pointerover">
              <Setter Property="Background" Value="#2A303C" />
              <Setter Property="Foreground" Value="#ECEEF2" />
            </Style>
            <Style Selector="ListBox.navList">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            </Style>
            <Style Selector="ListBox.navList ListBoxItem">
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="CornerRadius" Value="6" />
              <Setter Property="Margin" Value="4,1" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style Selector="ListBox.navList ListBoxItem:selected">
              <Setter Property="Background" Value="#262446" />
            </Style>
            <Style Selector="ListBox.navList ListBoxItem:pointerover">
              <Setter Property="Background" Value="#232932" />
            </Style>
            <Style Selector="ListBox.libraryList ListBoxItem:selected">
              <Setter Property="Background" Value="#3A2A12" />
            </Style>
            <Style Selector="ListBox.sundayList ListBoxItem:selected">
              <Setter Property="Background" Value="#2A2450" />
            </Style>
            <Style Selector="ListBox.notesList ListBoxItem:selected">
              <Setter Property="Background" Value="#3A2A12" />
            </Style>
          </Border.Styles>

          <Panel>
          <!-- Bible: two sibling views — Bookmarks (top) and Compare (bottom), like Songs library / setlist. -->
          <Grid IsVisible="{Binding IsBibleMode}" RowDefinitions="*,8,*" ClipToBounds="True">
            <Border Grid.Row="0" Background="#14181F">
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="sectionHeader" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="sectionLabel" Text="BOOKMARKS" />
                    <TextBlock Grid.Column="1" Text="&#9733;" FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock IsVisible="{Binding !Transcription.HasBookmarks}"
                               Text="No bookmarks yet — star a verse to pin it here"
                               Foreground="#5B626E" FontSize="11" Margin="14,8" TextWrapping="Wrap" />
                    <ListBox Classes="navList" ItemsSource="{Binding Transcription.Bookmarks}"
                             DoubleTapped="OnBookmarksDoubleTapped" IsVisible="{Binding Transcription.HasBookmarks}">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="content:SuggestionItem">
                          <Grid ColumnDefinitions="Auto,*" Background="Transparent"
                                ToolTip.Tip="Double-click to send live · right-click for more options">
                            <Grid.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Send to Live" Click="OnSendBookmarkToLiveMenu" />
                                <MenuItem Header="Show in Chapter" Click="OnShowFullChapterFromSuggestion" />
                                <MenuItem Header="Show Entire Book" Click="OnShowFullBookFromBookmark" />
                                <Separator />
                                <MenuItem Header="Remove Bookmark" Click="OnRemoveBookmarkMenu" />
                              </ContextMenu>
                            </Grid.ContextMenu>
                            <Panel Grid.Column="0" Margin="0,0,9,0">
                              <Border Background="#3A2A12" CornerRadius="5" Width="22" Height="22"
                                      VerticalAlignment="Center" IsVisible="{Binding !IsLive}">
                                <TextBlock Text="&#9733;" FontSize="11" Foreground="#F59E0B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <Border Background="#22C55E" CornerRadius="5" Width="22" Height="22"
                                      VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                                <Ellipse Width="6" Height="6" Fill="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding Title}" Foreground="#E6E9EE" FontSize="13"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <Border Background="#22C55E" CornerRadius="3" Padding="4,1"
                                        VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                                  <TextBlock Text="LIVE" Foreground="White" FontSize="7" FontWeight="Bold" />
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding Body}" Foreground="#6E7682" FontSize="11"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="#14181F" ClipToBounds="True">
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="sectionHeader" BorderBrush="#2A303C" BorderThickness="0,0,0,1"
                        ClipToBounds="True">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="sectionLabel" Text="COMPARE"
                               Foreground="#A78BFA" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Classes="hdrIcon" Padding="4,2"
                            ToolTip.Tip="Choose exactly 2 translations">
                      <icons:MaterialIcon Kind="Cog" Width="14" Height="14" Foreground="#8A92A0" />
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                          <StackPanel Width="168" Spacing="6">
                            <TextBlock Text="PICK 2 TRANSLATIONS" FontSize="10" FontWeight="Bold"
                                       Foreground="#8A92A0" LetterSpacing="0.6" />
                            <TextBlock Text="Two at a time. Uncheck one to pick another."
                                       FontSize="10" Foreground="#6E7682" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding CompareOptions}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="op:LiveCompareOption">
                                  <CheckBox Content="{Binding Code}" IsChecked="{Binding IsSelected}"
                                            IsEnabled="{Binding IsEnabled}" FontSize="12" Margin="0,2" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </Border>
                <ScrollViewer Padding="8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <Panel>
                    <ItemsControl ItemsSource="{Binding CompareCards}" IsVisible="{Binding HasCompareCards}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="op:LiveCompareCard">
                          <Border Background="#181C24" BorderBrush="#2A303C" BorderThickness="1" CornerRadius="8"
                                  Padding="8,7" Margin="0,0,0,6" Cursor="Hand" ClipToBounds="True"
                                  HorizontalAlignment="Stretch"
                                  DoubleTapped="OnLiveCompareDoubleTapped"
                                  ToolTip.Tip="Double-click to send this translation live">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Translation}" Foreground="#A78BFA" FontSize="11"
                                         FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Body}" Foreground="#C2C8D2" FontSize="12" LineHeight="18"
                                         TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="4" VerticalAlignment="Center" IsVisible="{Binding !HasCompareCards}">
                      <TextBlock Text="No compare translations" Foreground="#6E7682" FontSize="12" FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="Put a verse live, then use the cog to pick 2 translations."
                                 Foreground="#4B515C" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                  </Panel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding IsMediaMode}">
            <StackPanel>

              <!-- ── FOLDERS (Media mode) ────────────────────────────────── -->
              <StackPanel IsVisible="{Binding IsMediaMode}">
              <Border Classes="sectionHeader">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="sectionLabel" Text="FOLDERS" />
                  <Button Grid.Column="1" Classes="hdrIcon" Content="&#43;" Command="{Binding MediaPlayback.BeginNameFolderCommand}"
                          ToolTip.Tip="Create a folder to group media" />
                </Grid>
              </Border>

              <!-- Inline "name your folder" row (toggled by the + button) -->
              <Border IsVisible="{Binding MediaPlayback.IsNamingFolder}" Padding="8,8" Background="#14181F">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding MediaPlayback.NewFolderName}" Watermark="Name this folder…"
                           FontSize="12" Padding="8,6">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding MediaPlayback.CreateFolderCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1" Content="&#43;" Command="{Binding MediaPlayback.CreateFolderCommand}" Classes="ghost"
                          FontSize="14" Padding="9,3" Margin="5,0,0,0" ToolTip.Tip="Create folder" />
                </Grid>
              </Border>

              <ListBox Classes="navList" ItemsSource="{Binding MediaPlayback.Folders}"
                       SelectedItem="{Binding MediaPlayback.SelectedFolder}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="op:MediaFolderOption">
                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent"
                          ToolTip.Tip="Right-click a folder to delete it">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Delete folder" Click="OnDeleteMediaFolderMenu"
                                    IsVisible="{Binding CanDelete}" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <Border Grid.Column="0" Background="#15303A" CornerRadius="5" Width="22" Height="22"
                              VerticalAlignment="Center" Margin="0,0,9,0">
                        <TextBlock Text="&#128193;" FontSize="11" Foreground="#22D3EE"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E6E9EE" FontSize="13"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="hdrIcon" Content="&#8942;" Padding="4,1"
                              IsVisible="{Binding CanDelete}" ToolTip.Tip="Folder options">
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Delete folder" Click="OnDeleteMediaFolderMenu" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <!-- Songs mode: library on top, this Sunday's setlist below. Each pane scrolls on its own. -->
          <Grid IsVisible="{Binding IsSongsMode}" RowDefinitions="*,8,0.72*">
            <Border Grid.Row="0" Background="#12151C">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2A2110" Padding="12,8"
                        BorderBrush="#F59E0B" BorderThickness="0,0,0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" VerticalAlignment="Center" />
                      <TextBlock Text="SONGS LIBRARY" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"
                                 LetterSpacing="1.0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="hdrIcon" Content="&#43;" Tapped="OnNewSongClicked"
                            Foreground="#FBBF24" />
                  </Grid>
                </Border>
                <Panel>
                  <TextBlock IsVisible="{Binding !HasLibrarySongs}" Text="No songs yet — tap + to import"
                             Foreground="#5B626E" FontSize="11" Margin="14,10" TextWrapping="Wrap" />
                  <ListBox x:Name="LibraryListBox" Classes="navList libraryList"
                           ItemsSource="{Binding LibrarySongs}" SelectedItem="{Binding SelectedLibrarySong}"
                           DoubleTapped="OnLibrarySongDoubleTapped" IsVisible="{Binding HasLibrarySongs}"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="content:Song">
                        <Grid ColumnDefinitions="Auto,*" Background="Transparent"
                              ToolTip.Tip="Double-click to open in Now Singing · right-click to add to Sunday or send live">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Add to Sunday Playlist" Click="OnAddToSundayPlaylistMenu" />
                              <MenuItem Header="Send to Live" Click="OnSongSendLiveMenu" />
                              <Separator />
                              <MenuItem Header="Edit Song" Click="OnEditSongMenu" />
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <Border Grid.Column="0" Background="#3A2A12" CornerRadius="5" Width="22" Height="22"
                                  VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock Text="&#9835;" FontSize="11" Foreground="#F59E0B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="#E6E9EE" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{Binding Artist}" Foreground="#6E7682" FontSize="11"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Panel>
              </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="#16141F" BorderBrush="#7C6CF6" BorderThickness="0,2,0,0">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1E1A32" Padding="12,8"
                        BorderBrush="#A78BFA" BorderThickness="0,0,0,2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#A78BFA" VerticalAlignment="Center" />
                    <TextBlock Text="SUNDAY PLAYLIST" FontSize="10" FontWeight="Bold" Foreground="#C4B5FD"
                               LetterSpacing="1.0" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Panel>
                  <TextBlock IsVisible="{Binding !HasSundayPlaylist}"
                             Text="Right-click a library song and choose Add to Sunday Playlist. It stays here for service."
                             Foreground="#6B6288" FontSize="11" Margin="14,10" TextWrapping="Wrap" />
                  <ListBox x:Name="SundayPlaylistListBox" Classes="navList sundayList"
                           ItemsSource="{Binding SundayPlaylist}" SelectedItem="{Binding SelectedSundaySong}"
                           DoubleTapped="OnSundayPlaylistDoubleTapped" IsVisible="{Binding HasSundayPlaylist}"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="content:Song">
                        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent"
                              ToolTip.Tip="Double-click to open in Now Singing">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Open Song" Click="OnOpenSundaySongMenu" />
                              <MenuItem Header="Remove from Playlist" Click="OnRemoveSundaySongMenu" />
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <Border Grid.Column="0" Background="#262446" CornerRadius="5" Width="22" Height="22"
                                  VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock Text="&#9835;" FontSize="11" Foreground="#A78BFA"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="#E6E9EE" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{Binding Artist}" Foreground="#8B83A8" FontSize="11"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                          <Button Grid.Column="2" Click="OnRemoveSundaySongButton" Background="Transparent"
                                  BorderThickness="0" Padding="6,2" Foreground="#6B6288" FontSize="12"
                                  Content="&#10005;" ToolTip.Tip="Remove from Sunday playlist"
                                  VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Panel>
              </DockPanel>
            </Border>
          </Grid>

          <!-- Notes mode: saved notes on the left, slides open in the center. -->
          <Border IsVisible="{Binding IsNotesMode}" Background="#12151C">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#2A2110" Padding="12,8"
                      BorderBrush="#F59E0B" BorderThickness="0,0,0,2">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#FBBF24" VerticalAlignment="Center" />
                    <TextBlock Text="NOTES LIBRARY" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"
                               LetterSpacing="1.0" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="hdrIcon" Content="&#43;" Click="OnAddNote"
                          Foreground="#FBBF24" />
                </Grid>
              </Border>
              <Panel>
                <TextBlock IsVisible="{Binding !Notes.HasNotes}" Text="No notes yet — tap + to add one"
                           Foreground="#5B626E" FontSize="11" Margin="14,10" TextWrapping="Wrap" />
                <ListBox x:Name="NotesListBox" Classes="navList notesList"
                         ItemsSource="{Binding Notes.Cards}" SelectedItem="{Binding Notes.SelectedCard}"
                         DoubleTapped="OnNotesLibraryDoubleTapped" IsVisible="{Binding Notes.HasNotes}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="op:NoteSlideItem">
                      <Panel ToolTip.Tip="Double-click to open slides · right-click for options">
                        <Border IsVisible="{Binding IsOpen}" IsHitTestVisible="False"
                                BorderBrush="#FBBF24" BorderThickness="1.5" CornerRadius="6" />
                        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Send to Live" Click="OnNoteSendLiveMenu" />
                              <Separator />
                              <MenuItem Header="Edit…" Click="OnEditNoteMenu" />
                              <MenuItem Header="Delete" Click="OnDeleteNoteMenu" />
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <Border Grid.Column="0" Background="#3A2A12" CornerRadius="5" Width="22" Height="22"
                                  VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock Text="&#x1F4DD;" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="#E6E9EE" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{Binding SlideCountLabel}" Foreground="#6E7682" FontSize="11"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                          </StackPanel>
                          <Button Grid.Column="2" Click="OnDeleteNoteButton" Background="Transparent"
                                  BorderThickness="0" Padding="6,2" Foreground="#6E7682" FontSize="12"
                                  Content="&#10005;" ToolTip.Tip="Delete this note"
                                  VerticalAlignment="Center" />
                        </Grid>
                      </Panel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>
            </DockPanel>
          </Border>
          </Panel>
        </Border>

        <!-- Gutter: sidebar <-> center -->

        <!-- CENTER: AI / CONTENT (search + tabs + lists) — the core of the app -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding IsContentMode}">

          <!-- Single search bar: scripture lookup in Bible mode, smart lyric search in Songs mode.
               Typing in Songs mode drives the Songs results tab (see OperatorViewModel). -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8" IsVisible="{Binding !IsNotesMode}">
            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsBibleMode}">
              <TextBox Text="{Binding ContentSearch.SearchQuery}"
                       Watermark="{Binding SearchWatermark}" FontSize="13" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ContentSearch.AvailableTranslations}"
                        SelectedItem="{Binding ContentSearch.SelectedTranslation}"
                        Background="#181C24" Foreground="#ECEEF2" BorderBrush="#3C4350"
                        CornerRadius="6" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                        Margin="6,0,0,0" MinWidth="80"
                        ToolTip.Tip="Bible translation" />
            </Grid>
            <TextBox Grid.Column="0" Text="{Binding SongSearch.Query}"
                     Watermark="{Binding SearchWatermark}" FontSize="13"
                     IsVisible="{Binding IsSongsMode}" />
            <Button Grid.Column="1" Classes="ghost" Content="+ Import Song" Tapped="OnNewSongClicked"
                    Margin="6,0,0,0" IsVisible="{Binding IsSongsMode}" />
            <Button Grid.Column="2" Classes="ghost" Content="Clear" Command="{Binding ClearResultsCommand}"
                    Margin="6,0,0,0" FontSize="12" IsVisible="{Binding IsBibleMode}"
                    ToolTip.Tip="Clear the scripture results list" />
          </Grid>

          <!-- Tab bar: Library / AI Suggestions -->
          <Border Grid.Row="1" Background="#181C24" CornerRadius="10" BorderBrush="#2A303C" BorderThickness="1">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#1B202A" BorderBrush="#2A303C" BorderThickness="0,0,0,1"
                      IsVisible="{Binding !IsNotesMode}">
                <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <!-- Shared content tab: "Scripture" (reference lookups) in Bible mode, "Library" in Songs mode -->
                  <Panel>
                    <Button Command="{Binding ShowLibraryTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <Panel>
                        <TextBlock Text="{Binding LibraryTabLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                   IsVisible="{Binding IsLibraryTab}" />
                        <TextBlock Text="{Binding LibraryTabLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                   IsVisible="{Binding !IsLibraryTab}" />
                      </Panel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#7C6CF6"
                            IsVisible="{Binding IsLibraryTab}" />
                  </Panel>
                  <!-- AI Suggestions tab (Bible mode) -->
                  <Panel IsVisible="{Binding IsBibleMode}">
                    <Button Command="{Binding ShowSuggestionsTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel>
                          <TextBlock Text="AI Suggestions" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                     IsVisible="{Binding IsSuggestionsTab}" />
                          <TextBlock Text="AI Suggestions" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                     IsVisible="{Binding !IsSuggestionsTab}" />
                        </Panel>
                        <Border Background="#A78BFA" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                IsVisible="{Binding HasNewSuggestions}">
                          <TextBlock Text="{Binding AiSuggestionCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <Border Background="#232932" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                IsVisible="{Binding !HasNewSuggestions}">
                          <TextBlock Text="{Binding AiSuggestionCount}" Foreground="#959DAB" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </StackPanel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#A78BFA"
                            IsVisible="{Binding IsSuggestionsTab}" />
                  </Panel>
                  <!-- Find Scripture (topical) tab (Bible mode) -->
                  <Panel IsVisible="{Binding IsBibleMode}">
                    <Button Command="{Binding ShowTopicalTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel>
                          <TextBlock Text="Find Scripture" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                     IsVisible="{Binding IsTopicalTab}" />
                          <TextBlock Text="Find Scripture" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                     IsVisible="{Binding !IsTopicalTab}" />
                        </Panel>
                        <Border Background="#38BDF8" CornerRadius="10" Padding="7,2" VerticalAlignment="Center"
                                IsVisible="{Binding HasNewTopical}">
                          <TextBlock Text="!" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </StackPanel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#38BDF8"
                            IsVisible="{Binding IsTopicalTab}" />
                  </Panel>
                  <!-- AI Paraphrases tab — hidden until that feature is rebuilt. -->
                  <Panel IsVisible="{Binding ShowParaphrasesSubtab}">
                    <Button Command="{Binding ShowParaphrasesTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="&#x2728;" FontSize="12" Foreground="#A78BFA" VerticalAlignment="Center" />
                          <Panel>
                            <TextBlock Text="Paraphrases" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                       IsVisible="{Binding IsParaphrasesTab}" />
                            <TextBlock Text="Paraphrases" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                       IsVisible="{Binding !IsParaphrasesTab}" />
                          </Panel>
                        </StackPanel>
                        <Border Background="#A78BFA" CornerRadius="10" Padding="7,2" VerticalAlignment="Center"
                                IsVisible="{Binding HasNewParaphrases}">
                          <TextBlock Text="{Binding TopicalSearch.DetectedResults.Count}" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </StackPanel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#A78BFA"
                            IsVisible="{Binding IsParaphrasesTab}" />
                  </Panel>
                  <!-- Songs (lyric search) tab (Songs mode) -->
                  <Panel IsVisible="{Binding IsSongsMode}">
                    <Button Command="{Binding ShowSongsTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <Panel>
                        <TextBlock Text="Songs" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                   IsVisible="{Binding IsSongsTab}" />
                        <TextBlock Text="Songs" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                   IsVisible="{Binding !IsSongsTab}" />
                      </Panel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#F472B6"
                            IsVisible="{Binding IsSongsTab}" />
                  </Panel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="8,0,12,0"
                            IsVisible="{Binding ShowNowSingingToolbar}">
                  <Border Background="#3B1D3A" BorderBrush="#F472B6" BorderThickness="1"
                          CornerRadius="10" Padding="10,3"
                          MaxWidth="{x:Static svc:OperatorWorkspaceChrome.NowSingingTitleBubbleMaxWidth}">
                    <TextBlock Text="{Binding NowSingingTitle}" Foreground="#F9A8D4"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding NowSingingTitle}" />
                  </Border>
                  <TextBlock Text="{Binding FollowStatus}" Foreground="#F59E0B" FontSize="11"
                             FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsFollowOn}" />
                  <ToggleButton IsChecked="{Binding IsFollowOn, Mode=OneWay}" Command="{Binding ToggleFollowCommand}"
                                FontSize="12" Padding="11,5" CornerRadius="6"
                                ToolTip.Tip="Lyric Follow (Assist): listens and suggests the slide being sung from THIS song only. You still press send. Requires the mic on.">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#F59E0B"
                               IsVisible="{Binding IsFollowOn}" />
                      <TextBlock Text="Follow" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                              ToolTip.Tip="How many lyric lines per slide (0 = auto-fit to theme)">
                    <TextBlock Text="Lines" Foreground="#959DAB" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding LinesPerSlideOptions}" SelectedItem="{Binding NowSingingLinesPerSlide}"
                              FontSize="12" MinWidth="64" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button Content="+" FontSize="16" FontWeight="Bold" Padding="11,4" CornerRadius="6"
                          Background="#262446" Foreground="#C4B5FD" Click="OnAddNowSingingSlide"
                          ToolTip.Tip="Add a new slide to this song" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="A" Foreground="#6E7682" FontSize="11" VerticalAlignment="Center" />
                    <Slider Width="90" Minimum="0.7" Maximum="2.2" Value="{Binding SlideScale}"
                            VerticalAlignment="Center" ToolTip.Tip="Resize the slide cards" />
                    <TextBlock Text="A" Foreground="#ECEEF2" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                </Grid>
              </Border>

              <Panel>
                <!-- Scripture-lookup results (Bible mode, tab 0) — ProPresenter-style grid of slide cards -->
                <ListBox x:Name="ContentListBox"
                         ItemsSource="{Binding ContentSearch.Results}"
                         SelectedItem="{Binding ContentSearch.SelectedItem}"
                         Tapped="OnContentListTapped"
                         DoubleTapped="OnContentListDoubleTapped"
                         Background="Transparent" BorderThickness="0" Padding="8,10"
                         IsVisible="{Binding ShowScriptureList}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="6" />
                      <Setter Property="CornerRadius" Value="8" />
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="MinHeight" Value="0" />
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                    <Style Selector="ListBoxItem:selected Border#scrCard">
                      <Setter Property="BorderBrush" Value="#7C6CF6" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Border#scrCard">
                      <Setter Property="BorderBrush" Value="#4B5563" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="content:ContentItem">
                      <Panel HorizontalAlignment="Stretch">
                        <Border x:Name="scrCard" Background="#0B0D12" CornerRadius="8"
                                ClipToBounds="True" BorderBrush="#2A303C" BorderThickness="2" Cursor="Hand"
                                ToolTip.Tip="Click to preview · Shift+click another card for a range · double-click to send live">
                          <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Send to Live" Click="OnSendContentToLiveMenu" />
                              <MenuItem Header="Bookmark Verse" Click="OnBookmarkScriptureMenu"
                                        IsVisible="{Binding IsScripture}" />
                              <MenuItem Header="Show Full Chapter" Click="OnShowFullChapterFromContent"
                                        IsVisible="{Binding IsScripture}" />
                            </ContextMenu>
                          </Border.ContextMenu>
                          <StackPanel>
                            <!-- 16:9 slide preview of the verse text -->
                            <Border Height="118" Background="#000000" Padding="14">
                              <TextBlock Text="{Binding Body}" Foreground="#F4F6FA" FontWeight="SemiBold" FontSize="13"
                                         TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            </Border>
                            <!-- ProPresenter-style label bar: reference + translation/type -->
                            <Border Background="#7C6CF6" Padding="9,5">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White" FontWeight="Bold"
                                           FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Grid.Column="1" Text="{Binding Tag}" Foreground="#E6E1FF" FontWeight="SemiBold"
                                           FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                              </Grid>
                            </Border>
                          </StackPanel>
                        </Border>
                        <!-- Live ring: shows which scripture card is currently on output -->
                        <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                BorderBrush="#22C55E" BorderThickness="3" CornerRadius="8" />
                        <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                Background="#22C55E" CornerRadius="6" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold" />
                          </StackPanel>
                        </Border>
                        <!-- Origin highlight: the verse the operator opened this chapter from (e.g. an AI
                             suggestion). Amber so it never reads as LIVE; sits top-right, clear of the LIVE badge. -->
                        <Border IsVisible="{Binding IsOrigin}" IsHitTestVisible="False"
                                BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="8" />
                        <Border IsVisible="{Binding IsOrigin}" IsHitTestVisible="False"
                                Background="#F59E0B" CornerRadius="6" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                ToolTip.Tip="The verse you opened this chapter from">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="★" Foreground="#1A1205" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="FROM HERE" Foreground="#1A1205" FontSize="9" FontWeight="Bold" />
                          </StackPanel>
                        </Border>
                        <!-- Range: same 22×22 rounded chip as the bookmark star, sky so it is not
                             amber (bookmark), green (LIVE), or purple (selected). -->
                        <Border IsVisible="{Binding IsRangeSelected}" IsHitTestVisible="False"
                                BorderBrush="#38BDF8" BorderThickness="3" CornerRadius="8" />
                        <Border IsVisible="{Binding IsRangeSelected}" IsHitTestVisible="False"
                                Background="#0C2A3A" CornerRadius="5" Width="22" Height="22"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6">
                          <TextBlock Text="↕" FontSize="11" Foreground="#38BDF8"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Panel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- Now Singing (Songs mode, tab 0): the opened song's slides; double-click one to project it -->
                <DockPanel IsVisible="{Binding ShowNowSinging}">
                  <Panel>
                    <StackPanel IsVisible="{Binding !HasNowSinging}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                      <TextBlock Text="&#9835;" FontSize="34" Foreground="#3C4350" HorizontalAlignment="Center" />
                      <TextBlock Text="Pick a song from the Library" Foreground="#6E7682" FontSize="14" HorizontalAlignment="Center" />
                      <TextBlock Text="Double-click a song in the left sidebar to load its slides here"
                                 Foreground="#4B515C" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="NowSingingListBox"
                             ItemsSource="{Binding NowSingingSlides}"
                             SelectedItem="{Binding SelectedNowSingingSlide}"
                             DoubleTapped="OnNowSingingSlideDoubleTapped"
                             KeyDown="OnNowSingingKeyDown"
                             IsVisible="{Binding HasNowSinging}"
                             Background="Transparent" BorderThickness="0" Padding="8,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="6" />
                          <Setter Property="CornerRadius" Value="8" />
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="MinHeight" Value="0" />
                          <Setter Property="VerticalAlignment" Value="Top" />
                          <Setter Property="HorizontalAlignment" Value="Left" />
                          <Setter Property="VerticalContentAlignment" Value="Top" />
                          <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                        <Style Selector="ListBoxItem:selected Border#nowCard">
                          <Setter Property="BorderBrush" Value="#F472B6" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border#nowCard">
                          <Setter Property="BorderBrush" Value="#4B5563" />
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="op:SongSlideItem">
                          <Panel HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Width="{Binding CardWidth}">
                            <Border x:Name="nowCard" Background="#0B0D12" CornerRadius="8"
                                    ClipToBounds="True" BorderBrush="#2A303C" BorderThickness="2" Cursor="Hand"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="Double-click to send this section live · right-click for options">
                              <Border.ContextFlyout>
                                <MenuFlyout>
                                  <MenuItem Header="Send to live" Click="OnSlideSendLiveMenu" />
                                  <MenuItem Header="Add slide after this…" Click="OnAddSlideAfterMenu" />
                                  <Separator />
                                  <MenuItem Header="Quick edit slide…" Click="OnQuickEditSlideMenu" />
                                  <MenuItem Header="Full edit song…" Click="OnFullEditSongMenu" />
                                </MenuFlyout>
                              </Border.ContextFlyout>
                              <StackPanel>
                                <!-- 16:9 slide preview -->
                                <Border Height="{Binding PreviewHeight}"
                                        Background="#000000" Padding="12">
                                  <TextBlock Text="{Binding Text}" Foreground="#F4F6FA" FontWeight="SemiBold"
                                             FontSize="{Binding TextSize}"
                                             TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <!-- ProPresenter-style label bar (blue=verse, magenta=chorus) -->
                                <Border Background="{Binding BarBrush}" Padding="9,4">
                                  <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold"
                                             FontSize="{Binding LabelSize}"
                                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </Border>
                              </StackPanel>
                            </Border>
                            <!-- Follow ring: lyric-follow's current suggestion (amber, distinct from live green) -->
                            <Border IsVisible="{Binding IsSuggested}" IsHitTestVisible="False"
                                    BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="8" />
                            <Border IsVisible="{Binding IsSuggested}" IsHitTestVisible="False"
                                    Background="#F59E0B" CornerRadius="6" Padding="6,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                              <TextBlock Text="FOLLOW" Foreground="#1A1206" FontSize="9" FontWeight="Bold" />
                            </Border>
                            <!-- Live ring: shows which slide is currently on output -->
                            <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                    BorderBrush="#22C55E" BorderThickness="3" CornerRadius="8" />
                            <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                    Background="#22C55E" CornerRadius="6" Padding="6,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                                <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold" />
                              </StackPanel>
                            </Border>
                          </Panel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Panel>
                </DockPanel>

                <!-- AI Suggestions tab content -->
                <DockPanel IsVisible="{Binding ShowSuggestionsTabContent}">
                  <Border DockPanel.Dock="Top" Padding="12,8" IsVisible="{Binding Transcription.IsListening}">
                    <StackPanel Spacing="3">
                      <TextBlock Foreground="#959DAB" FontSize="12" FontStyle="Italic"
                                 Text="Listening for scriptures and content..." />
                      <TextBlock Foreground="#F59E0B" FontSize="11" Text="{Binding AiUsageText}"
                                 IsVisible="{Binding AiNearLimit}" />
                    </StackPanel>
                  </Border>
                  <Border DockPanel.Dock="Top" Padding="12,8" IsVisible="{Binding ShowSuggestionsStartPrompt}">
                    <StackPanel Spacing="6">
                      <!-- AI available: normal start -->
                      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanUseAi}">
                        <TextBlock Foreground="#959DAB" FontSize="12"
                                   Text="AI Listening is off." VerticalAlignment="Center" />
                        <Button Content="Start Listening" FontSize="12" Padding="10,5" CornerRadius="6"
                                Background="#A78BFA" Foreground="White" FontWeight="SemiBold"
                                Command="{Binding Transcription.ToggleListeningCommand}" />
                      </StackPanel>
                      <!-- AI blocked: monthly limit reached / not active → upgrade -->
                      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding AiBlocked}">
                        <TextBlock Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center"
                                   MaxWidth="320" TextWrapping="Wrap" Text="{Binding AiUsageText}" />
                        <Button Content="Upgrade" FontSize="12" Padding="10,5" CornerRadius="6"
                                Background="#A78BFA" Foreground="White" FontWeight="SemiBold"
                                Command="{Binding RequestUpgradeCommand}" CommandParameter="ai" />
                      </StackPanel>
                      <TextBlock Foreground="#6E7682" FontSize="11" Text="{Binding AiUsageText}"
                                 IsVisible="{Binding CanUseAi}" />
                    </StackPanel>
                  </Border>
                  <Border DockPanel.Dock="Top" Padding="8,4">
                    <Button Classes="ghost" Content="Clear list" Command="{Binding ClearSuggestionsCommand}"
                            HorizontalAlignment="Right" FontSize="11" Padding="8,4"
                            ToolTip.Tip="Remove all AI suggestions from this list (does not change what is live)" />
                  </Border>
                  <ListBox x:Name="SuggestionsListBox"
                           ItemsSource="{Binding Transcription.Suggestions}"
                           SelectedItem="{Binding Transcription.SelectedSuggestion}"
                           Tapped="OnSuggestionsTapped"
                           DoubleTapped="OnSuggestionsDoubleTapped"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="4,1" />
                        <Setter Property="MinHeight" Value="0" />
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#2A2444" />
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#232932" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="content:SuggestionItem">
                        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Send to Live" Click="OnSendSuggestionToLiveMenu" />
                              <MenuItem Header="Bookmark Verse" Click="OnToggleBookmarkMenu"
                                        IsVisible="{Binding !IsBookmarked}" />
                              <MenuItem Header="Remove Bookmark" Click="OnToggleBookmarkMenu"
                                        IsVisible="{Binding IsBookmarked}" />
                              <MenuItem Header="Show Full Chapter" Click="OnShowFullChapterFromSuggestion"
                                        IsVisible="{Binding IsScripture}" />
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <Panel Grid.Column="0" Margin="0,0,10,0">
                            <Border Background="#2A2444" CornerRadius="6" Width="28" Height="28"
                                    VerticalAlignment="Center" IsVisible="{Binding !IsLive}">
                              <TextBlock Text="{Binding Icon}" FontSize="12" FontWeight="Bold" Foreground="#A78BFA"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Background="#22C55E" CornerRadius="6" Width="28" Height="28"
                                    VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                              <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                          </Panel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Title}" Foreground="#ECEEF2" FontSize="13" FontWeight="Medium"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                              <Border Background="#22C55E" CornerRadius="4" Padding="5,1"
                                      VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                                <TextBlock Text="LIVE" Foreground="White" FontSize="8" FontWeight="Bold" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Body}" Foreground="#959DAB" FontSize="12"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Click="OnToggleBookmarkButton" Background="Transparent" BorderThickness="0"
                                    Padding="4,2" CornerRadius="4" ToolTip.Tip="Bookmark verse">
                              <Panel>
                                <TextBlock Text="&#9733;" FontSize="15" Foreground="#F59E0B"
                                           IsVisible="{Binding IsBookmarked}" />
                                <TextBlock Text="&#9734;" FontSize="15" Foreground="#C4B5FD"
                                           IsVisible="{Binding !IsBookmarked}" />
                              </Panel>
                            </Button>
                            <Border Background="#2A2444" CornerRadius="4" Padding="8,3" Margin="2,0">
                              <TextBlock Text="{Binding ScoreDisplay}" Foreground="#A78BFA" FontSize="11" FontWeight="Medium" />
                            </Border>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>

                <!-- Find Scripture (topical) tab content -->
                <DockPanel IsVisible="{Binding ShowTopicalTabContent}">
                 <DockPanel DataContext="{Binding TopicalSearch}">
                  <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="6">
                      <TextBox Text="{Binding Query}" Watermark="Describe a passage, e.g. &quot;go into the nations and preach&quot;"
                               FontSize="13" Padding="8,6" CornerRadius="6" />
                      <TextBlock Text="{Binding StatusText}" Foreground="#959DAB" FontSize="11" FontStyle="Italic" />
                    </StackPanel>
                  </Border>
                  <ListBox x:Name="TopicalListBox"
                           ItemsSource="{Binding Results}"
                           SelectedItem="{Binding SelectedItem}"
                           Tapped="OnTopicalListTapped"
                           DoubleTapped="OnTopicalListDoubleTapped"
                           Background="Transparent" BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="CornerRadius" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                      </Style>
                      <Style Selector="ListBoxItem:selected Border#slideCard">
                        <Setter Property="BorderBrush" Value="#38BDF8" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="content:ContentItem">
                        <Panel Width="212">
                          <Border x:Name="slideCard" Background="#161A22" CornerRadius="10"
                                  BorderBrush="#2A303C" BorderThickness="2"
                                  ToolTip.Tip="Double-click to send this slide live">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Send to Live" Click="OnSendContentToLiveMenu" />
                                <MenuItem Header="Bookmark Verse" Click="OnBookmarkScriptureMenu"
                                          IsVisible="{Binding IsScripture}" />
                                <MenuItem Header="Show Full Chapter" Click="OnShowFullChapterFromContent"
                                          IsVisible="{Binding IsScripture}" />
                              </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                              <!-- 16:9 slide preview -->
                              <Border Height="118" CornerRadius="8,8,0,0" ClipToBounds="True" Background="#05070B" Padding="12">
                                <TextBlock Text="{Binding Body}" Foreground="#EEF1F6" FontSize="11"
                                           TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                              </Border>
                              <!-- caption -->
                              <Grid ColumnDefinitions="*,Auto" Margin="10,7,10,9">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#ECEEF2" FontSize="12"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#102733" CornerRadius="4" Padding="7,2" Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Tag}" Foreground="#38BDF8" FontSize="9" FontWeight="Medium" />
                                </Border>
                              </Grid>
                            </StackPanel>
                          </Border>
                          <!-- Live ring: shows which scripture card is currently on output -->
                          <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                  BorderBrush="#22C55E" BorderThickness="3" CornerRadius="10" />
                          <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                  Background="#22C55E" CornerRadius="6" Padding="6,2"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                              <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold" />
                            </StackPanel>
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                 </DockPanel>
                </DockPanel>

                <!-- AI Paraphrases tab content: verses auto-detected from live preaching. On its own
                     tab so it never crowds the manual Find Scripture results. -->
                <DockPanel IsVisible="{Binding ShowParaphrasesTabContent}">
                 <DockPanel DataContext="{Binding TopicalSearch}">
                  <Border DockPanel.Dock="Top" Padding="10,8" Background="#141A29" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="&#x2728;" FontSize="12" Foreground="#A78BFA" VerticalAlignment="Center" />
                      <TextBlock Text="Detected while preaching" Foreground="#C7B6F5" FontSize="12"
                                 FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Panel>
                    <!-- Listening / empty state -->
                    <StackPanel IsVisible="{Binding !HasDetected}" Spacing="8" Margin="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="&#x2728;" FontSize="28" Foreground="#3A3360" HorizontalAlignment="Center" />
                      <TextBlock Text="Paraphrased verses will appear here" Foreground="#6E7682" FontSize="13"
                                 FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Text="When the preacher paraphrases a passage, matching verses surface here automatically while the mic is listening."
                                 Foreground="#5A626E" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                    </StackPanel>
                    <ListBox x:Name="DetectedListBox"
                             IsVisible="{Binding HasDetected}"
                             ItemsSource="{Binding DetectedResults}"
                             SelectedItem="{Binding SelectedDetectedItem}"
                             Tapped="OnTopicalListTapped"
                             DoubleTapped="OnTopicalListDoubleTapped"
                             Background="Transparent" BorderThickness="0" Padding="8,8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="0,3" />
                          <Setter Property="Background" Value="Transparent" />
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="content:ContentItem">
                          <Border Background="#161A22" CornerRadius="8" BorderBrush="#2A303C" BorderThickness="1"
                                  Padding="10,7" ToolTip.Tip="Double-click to send this verse live">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Send to Live" Click="OnSendContentToLiveMenu" />
                                <MenuItem Header="Bookmark Verse" Click="OnBookmarkScriptureMenu"
                                          IsVisible="{Binding IsScripture}" />
                                <MenuItem Header="Show Full Chapter" Click="OnShowFullChapterFromContent"
                                          IsVisible="{Binding IsScripture}" />
                              </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Spacing="3">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#ECEEF2" FontSize="12"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#241B3A" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Tag}" Foreground="#A78BFA" FontSize="9" FontWeight="Medium" />
                                </Border>
                              </Grid>
                              <TextBlock Text="{Binding Body}" Foreground="#9AA3B2" FontSize="11"
                                         TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Panel>
                 </DockPanel>
                </DockPanel>

                <!-- Songs (smart lyric search) tab content: a results list. "Show full song" opens it
                     in the Now Singing tab, where the slide view lives. -->
                <DockPanel IsVisible="{Binding ShowSongsTabContent}">
                 <DockPanel DataContext="{Binding SongSearch}">
                  <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding StatusText}" Foreground="#959DAB" FontSize="11" FontStyle="Italic" />
                  </Border>
                  <ListBox x:Name="SongSearchListBox"
                           ItemsSource="{Binding Results}"
                           SelectedItem="{Binding SelectedHit}"
                           Tapped="OnSongSearchTapped"
                           DoubleTapped="OnSongSearchDoubleTapped"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="4,1" />
                        <Setter Property="MinHeight" Value="0" />
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#3A1F30" />
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#232932" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="op:SongHitViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent"
                              ToolTip.Tip="Double-click (or “Show full song”) to open it in Now Singing">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Show Full Song" Click="OnSongShowLyricsMenu" />
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <Border Grid.Column="0" Background="#3A1F30" CornerRadius="6" Width="28" Height="28"
                                  VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="&#9835;" FontSize="13" FontWeight="Bold" Foreground="#F472B6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="#ECEEF2" FontSize="13" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{Binding Snippet}" Foreground="#959DAB" FontSize="12" FontStyle="Italic"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2" Background="#3A1F30" CornerRadius="4" Padding="8,3"
                                  VerticalAlignment="Center" Margin="6,0"
                                  IsVisible="{Binding HasMatchedLabel}">
                            <TextBlock Text="{Binding MatchedLabel}" Foreground="#F472B6" FontSize="10" FontWeight="Medium" />
                          </Border>
                          <Button Grid.Column="3" Classes="ghost" Click="OnShowFullSong" VerticalAlignment="Center"
                                  Padding="10,5" Margin="4,0,0,0" ToolTip.Tip="Open in Now Singing">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Text="Show full song" FontSize="12" VerticalAlignment="Center" />
                              <TextBlock Text="&#9662;" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                 </DockPanel>
                </DockPanel>

                <!-- Notes: open-note slides in the center (library lives in the left sidebar). -->
                <DockPanel IsVisible="{Binding ShowNotesTabContent}">
                  <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <Button Grid.Column="0" Content="← Close" Click="OnCloseOpenNote"
                              IsVisible="{Binding HasOpenNote}"
                              FontSize="12" Padding="10,6" Margin="0,0,10,0"
                              Background="#222732" Foreground="#C2C8D2" FontWeight="SemiBold"
                              ToolTip.Tip="Close this note" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                 Foreground="#959DAB" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Content="Edit note" Click="OnEditOpenNote"
                              IsVisible="{Binding HasOpenNote}"
                              FontSize="12" Padding="12,6" Margin="0,0,8,0"
                              Background="#2A303C" Foreground="#ECEEF2" FontWeight="SemiBold" />
                      <Button Grid.Column="3" Content="Delete" Click="OnDeleteOpenNote"
                              IsVisible="{Binding HasOpenNote}"
                              FontSize="12" Padding="12,6"
                              Background="#3A1F24" Foreground="#FCA5A5" FontWeight="SemiBold" />
                    </Grid>
                  </Border>

                  <Panel>
                  <!-- Open note: slide breakdown -->
                  <DockPanel IsVisible="{Binding HasOpenNote}">
                    <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding OpenNoteTitle}" Foreground="#ECEEF2" FontSize="14" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" MaxLines="1" />
                          <TextBlock Text="Double-click a slide to send it live · ← → step live"
                                     Foreground="#6E7682" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                    ToolTip.Tip="How many lines per slide (Auto = split mode / theme fit)">
                          <TextBlock Text="Lines" Foreground="#959DAB" FontSize="11" VerticalAlignment="Center" />
                          <ComboBox ItemsSource="{Binding NoteLinesPerSlideChoices}"
                                    SelectedItem="{Binding NowNoteLinesPerSlideChoice, Mode=TwoWay}"
                                    FontSize="12" MinWidth="72" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <ListBox x:Name="NotePagesListBox"
                             ItemsSource="{Binding NowNoteSlides}"
                             SelectedItem="{Binding SelectedNotePage}"
                             DoubleTapped="OnNotePageDoubleTapped"
                             KeyDown="OnNotePageKeyDown"
                             Background="Transparent" BorderThickness="0" Padding="8,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="6" />
                          <Setter Property="CornerRadius" Value="8" />
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="MinHeight" Value="0" />
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="op:NotePageSlideItem">
                          <Panel HorizontalAlignment="Stretch">
                            <Border Background="#0B0D12" CornerRadius="8" ClipToBounds="True"
                                    BorderBrush="#2A303C" BorderThickness="2" Cursor="Hand"
                                    ToolTip.Tip="Double-click to send this slide live · right-click to edit">
                              <Border.ContextFlyout>
                                <MenuFlyout>
                                  <MenuItem Header="Send to live" Click="OnNotePageSendLiveMenu" />
                                  <MenuItem Header="Add slide after this…" Click="OnNotePageAddAfterMenu" />
                                  <Separator />
                                  <MenuItem Header="Quick edit slide…" Click="OnNotePageQuickEditMenu" />
                                  <MenuItem Header="Edit whole note…" Click="OnEditOpenNote" />
                                </MenuFlyout>
                              </Border.ContextFlyout>
                              <StackPanel>
                                <Border Height="116" Background="#000000" Padding="12">
                                  <TextBlock Text="{Binding Body}" Foreground="#F4F6FA" FontWeight="SemiBold"
                                             FontSize="11" TextWrapping="Wrap" MaxLines="6"
                                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <Border Background="#7C6CF6" Padding="9,4">
                                  <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold" FontSize="10"
                                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </Border>
                              </StackPanel>
                            </Border>
                            <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                    BorderBrush="#22C55E" BorderThickness="3" CornerRadius="8" />
                            <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                    Background="#22C55E" CornerRadius="6" Padding="6,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                                <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold" />
                              </StackPanel>
                            </Border>
                          </Panel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>

                  <StackPanel IsVisible="{Binding !HasOpenNote}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="&#x1F4DD;" FontSize="26" HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock Text="No note open." Foreground="#959DAB" FontSize="13" HorizontalAlignment="Center" />
                    <TextBlock Text="Double-click a note in the library to open its slides."
                               Foreground="#6E7682" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                  </Panel>
                </DockPanel>

              </Panel>
            </DockPanel>
          </Border>

        </Grid>

        <!-- CENTER (Media mode): the media bin + transport, swapped in for the content tabs -->
        <Border Grid.Column="2" IsVisible="{Binding IsMediaMode}"
                Background="#181C24" CornerRadius="10" BorderBrush="#2A303C" BorderThickness="1">
          <DockPanel DataContext="{Binding MediaPlayback}">

            <!-- Toolbar: send-to screen, audio out, add, stop -->
            <Border DockPanel.Dock="Top" Background="#1B202A" Padding="12,9" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Send to" Foreground="#959DAB" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                <ComboBox Grid.Column="1" MinWidth="130" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                          FontSize="12" ToolTip.Tip="Which screen this media plays on — All screens, or just one">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="op:MediaTargetOption">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Text="&#9834; Audio" Foreground="#959DAB" FontSize="12" VerticalAlignment="Center" />
                  <ComboBox MinWidth="170" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                            FontSize="12" ToolTip.Tip="Where video sound is sent">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="uisvc:AudioOutputOption">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <Button Content="+ Add media" Click="OnAddMediaClicked" Classes="ghost" FontSize="12" Padding="10,6" />
                  <Button Content="Clear video" Command="{Binding StopCommand}" IsEnabled="{Binding HasLiveOnTarget}"
                          Foreground="#F87171" FontWeight="SemiBold" FontSize="12" Padding="12,6"
                          ToolTip.Tip="Clear live video from the selected screen" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Transport bar (shown while a video is live on the selected channel) -->
            <Border DockPanel.Dock="Bottom" Background="#14181F" Padding="12,9" BorderBrush="#2A303C" BorderThickness="0,1,0,0"
                    IsVisible="{Binding HasVideoLive}">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Command="{Binding SkipBackCommand}" Classes="queueBtn iconBtn"
                        Padding="9,5" ToolTip.Tip="Back 10s">
                  <Path Data="M 2,8 L 8,3.5 L 8,12.5 Z M 8,8 L 14,3.5 L 14,12.5 Z" />
                </Button>
                <Button Grid.Column="1" Command="{Binding PlayPauseCommand}" Classes="queueBtn iconBtn"
                        Padding="11,5" ToolTip.Tip="Play / pause">
                  <Panel Width="14" Height="14">
                    <Path Data="M 3,2 L 3,14 L 13,8 Z" IsVisible="{Binding IsPaused}" />
                    <Path Data="M 3,2 H 6.5 V 14 H 3 Z M 9.5,2 H 13 V 14 H 9.5 Z" IsVisible="{Binding !IsPaused}" />
                  </Panel>
                </Button>
                <Button Grid.Column="2" Command="{Binding SkipForwardCommand}" Classes="queueBtn iconBtn"
                        Padding="9,5" ToolTip.Tip="Forward 10s">
                  <Path Data="M 2,3.5 L 2,12.5 L 8,8 Z M 8,3.5 L 8,12.5 L 14,8 Z" />
                </Button>

                <Slider Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding PositionFraction}"
                        VerticalAlignment="Center" Margin="6,0" ToolTip.Tip="Scrub" />

                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="#C2C8D2">
                  <Run Text="{Binding PositionText}" /><Run Text=" / " Foreground="#5C6470" /><Run Text="{Binding DurationText}" Foreground="#8A93A2" />
                </TextBlock>

                <Path Grid.Column="5" Data="M 1,6 H 4 L 8,3 V 13 L 4,10 H 1 Z M 9.5,6.2 C 10.6,7.2 10.6,8.8 9.5,9.8"
                      Fill="#8A93A2" Stretch="Uniform" Width="14" Height="14" Margin="10,0,0,0"
                      VerticalAlignment="Center" />
                <Slider Grid.Column="6" Width="100" Minimum="0" Maximum="100" Value="{Binding Volume}"
                        VerticalAlignment="Center" ToolTip.Tip="Volume" />
              </Grid>
            </Border>

            <!-- Media bin (folders now live in the shared left sidebar, per mode) -->
            <ScrollViewer Padding="10" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="op:MediaTileViewModel">
                    <Border Width="200" Height="128" Margin="6" CornerRadius="10" ClipToBounds="True"
                            Background="#161A22" BorderBrush="#2A303C" BorderThickness="1"
                            Tapped="OnMediaTileTapped" ContextRequested="OnMediaTileContextRequested" Cursor="Hand">
                      <Panel>
                        <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}" Stretch="UniformToFill" />
                        <Border IsVisible="{Binding !HasThumbnail}" Background="#10131A">
                          <TextBlock Text="&#9654;" FontSize="26" Foreground="#5B6472"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border IsVisible="{Binding IsVideo}" Background="#CC111418" CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                          <TextBlock Text="{Binding ClipBadge}" FontSize="10" Foreground="#C2C8D2" />
                        </Border>

                        <Border IsVisible="{Binding IsLive}" BorderBrush="#F43F5E" BorderThickness="3" CornerRadius="9" />
                        <Border IsVisible="{Binding IsLiveAnywhere}" Background="#F43F5E" CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7">
                          <TextBlock Text="{Binding LiveOn}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>

                        <Border VerticalAlignment="Bottom" Background="#CC0B0D12" Padding="8,5">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#ECEEF2" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="&#10005;" Tapped="OnRemoveMediaTile" FontSize="11"
                                    Background="Transparent" Foreground="#8A93A2" Padding="6,1"
                                    ToolTip.Tip="Remove from library" />
                          </Grid>
                        </Border>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Gutter: content <-> right rail -->

        <!-- RIGHT RAIL: compact Program monitor (top) + Now Live readout (below) -->
        <Grid x:Name="ProgramRailGrid" Grid.Column="4" ClipToBounds="True" MinHeight="0"
              VerticalAlignment="Stretch" SizeChanged="OnProgramRailSizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
          </Grid.RowDefinitions>

          <!-- PROGRAM: the same compact 16:9 monitor in every mode (the Bible-mode shape). -->
          <Border Grid.Row="0" CornerRadius="10" BorderBrush="#22C55E" BorderThickness="2" Background="#14181F"
                  VerticalAlignment="Top">
          <Border CornerRadius="8" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,Auto">
            <Border Grid.Row="0" Background="#1B202A" Padding="10,7" BorderBrush="#2A303C" BorderThickness="0,0,0,1"
                    ClipToBounds="True">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Classes="section" Text="PROGRAM" Foreground="#22C55E" FontSize="11" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="#22C55E" CornerRadius="4" Padding="8,2" Margin="8,0,0,0"
                        VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                  <TextBlock Text="ON AIR" Foreground="White" FontSize="9" FontWeight="Bold" />
                </Border>
                <!-- Theme switcher fills leftover width and shrinks instead of overflowing neighbors. -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding LiveThemeOptions}" SelectedItem="{Binding LiveThemeName}"
                          MinWidth="0" MaxWidth="160" Margin="8,0" FontSize="11" Padding="6,2"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          IsVisible="{Binding IsLive}"
                          ToolTip.Tip="Switch the theme for the current slide type (applies live)" />
                <Border Grid.Column="3" Background="#7C6CF6" CornerRadius="4" Padding="8,2"
                        VerticalAlignment="Center" IsVisible="{Binding HasMultipleSlides}"
                        ToolTip.Tip="Arrow keys page through this passage">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="PAGE" Foreground="#C7D2FE" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DeckPositionText}" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Row="2" Background="#14181F" Padding="10,7" BorderBrush="#2A303C" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="queueBtn iconBtn" Click="OnPageBack"
                        Padding="12,6" ToolTip.Tip="Previous page (Left arrow)">
                  <Path Data="M 11,2 L 4,8 L 11,14 Z" />
                </Button>
                <Button Grid.Column="1" Classes="danger" Content="Blank" Command="{Binding BlankCommand}"
                        HorizontalAlignment="Center" Margin="8,0" FontSize="12" Padding="22,6"
                        ToolTip.Tip="Clear the screen to black (Esc)" />
                <Button Grid.Column="2" Classes="queueBtn iconBtn" Click="OnPageForward"
                        Padding="12,6" ToolTip.Tip="Next page (Right arrow)">
                  <Path Data="M 3,2 L 10,8 L 3,14 Z" />
                </Button>
              </Grid>
            </Border>

            <!-- 16:9 box, rail-width × (width×9/16). Same in Bible, Songs, Media, Notes. -->
            <Grid x:Name="ProgramPreviewHost" Grid.Row="1" Height="200"
                  HorizontalAlignment="Stretch" Background="#14181F" ClipToBounds="True"
                  SizeChanged="OnProgramPreviewHostSizeChanged">
              <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Width="1920" Height="1080" ClipToBounds="True">
                  <views:ProjectorView DataContext="{Binding ProgramPreview}" />
                </Border>
              </Viewbox>
              <StackPanel IsVisible="{Binding ShowProgramEmptyHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                          IsHitTestVisible="False">
                <TextBlock Text="Screen is blank" Foreground="#6E7682" FontSize="13" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ProgramEmptyHintDetail}" Foreground="#4B515C" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
          </Border>
          </Border>

          <!-- AI LISTENING: leftover rail only. Transcript fills; controls stay pinned. -->
          <Border Grid.Row="1" Margin="0,6,0,0" MinHeight="0" VerticalAlignment="Stretch"
                  Background="#12202E" CornerRadius="10" BorderBrush="#2B5A7A" BorderThickness="1" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Grid.Row="0" Background="#163044" BorderBrush="#2B5A7A" BorderThickness="0,0,0,1">
                <Button Classes="ghost" Command="{Binding ToggleAiListeningSectionCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"
                        ToolTip.Tip="Show or hide AI listening controls">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="Microphone" Width="14" Height="14" Foreground="#38BDF8" />
                    <TextBlock Text="AI LISTENING" Classes="section" Foreground="#38BDF8" FontSize="11"
                               VerticalAlignment="Center" />
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" IsVisible="{Binding Transcription.IsListening}">
                      <Ellipse.Fill><SolidColorBrush Color="#22C55E" /></Ellipse.Fill>
                    </Ellipse>
                  </StackPanel>
                </Button>
              </Border>

              <Border Grid.Row="1" Margin="12,8,12,0" MinHeight="{x:Static svc:OperatorWorkspaceChrome.TranscriptBoxMinHeight}"
                      IsVisible="{Binding AiListeningExpanded}"
                      ClipToBounds="True"
                      Background="#0E1014" CornerRadius="8" Padding="10,8"
                      BorderBrush="#2A303C" BorderThickness="1">
                <Grid RowDefinitions="Auto,*" DataContext="{Binding Transcription}">
                  <TextBlock Grid.Row="0" Text="LIVE TRANSCRIPT" Classes="section" Foreground="#6E7682" FontSize="10" Margin="0,0,0,6" />
                  <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding RecentTranscript}" Foreground="#C9D2DE" FontSize="13" LineHeight="18"
                               TextWrapping="Wrap" />
                  </ScrollViewer>
                </Grid>
              </Border>

              <StackPanel Grid.Row="2" Spacing="8" Margin="12,8,12,10"
                          IsVisible="{Binding AiListeningExpanded}">
              <StackPanel Spacing="8" DataContext="{Binding Transcription}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Command="{Binding ToggleTranscriptCommand}" Padding="6,3" FontSize="12"
                            ToolTip.Tip="Show / hide the live transcript">
                      <icons:MaterialIcon Kind="TextBoxOutline" Width="14" Height="14" Foreground="#8A92A0" />
                    </Button>
                    <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Background="#1E2530"
                            BorderBrush="#2F3845" BorderThickness="1" IsVisible="{Binding ShowEngineName}"
                            ToolTip.Tip="Active speech-to-text engine">
                      <TextBlock Text="{Binding EngineName}" Foreground="#8B93A1" FontSize="10" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="#232932">
                      <TextBlock Text="{Binding StatusText}" Foreground="#A7AFBC" FontSize="11" MaxWidth="180"
                                 TextTrimming="CharacterEllipsis" />
                    </Border>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsListening}">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding HasSignal}">
                      <Ellipse.Fill><SolidColorBrush Color="#22C55E" /></Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding !HasSignal}">
                      <Ellipse.Fill><SolidColorBrush Color="#3C4350" /></Ellipse.Fill>
                    </Ellipse>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding AudioLevelPercent}" Height="6" Width="140"
                                 VerticalAlignment="Center" CornerRadius="3">
                      <ProgressBar.Styles>
                        <Style Selector="ProgressBar /template/ Border#PART_Indicator">
                          <Setter Property="Background" Value="#38BDF8" />
                          <Setter Property="CornerRadius" Value="3" />
                        </Style>
                        <Style Selector="ProgressBar">
                          <Setter Property="Background" Value="#232932" />
                        </Style>
                      </ProgressBar.Styles>
                    </ProgressBar>
                  </StackPanel>

                  <StackPanel Spacing="6"
                              ToolTip.Tip="Mic sensitivity — raise if the meter barely moves; lower if it pins to the top / clips.">
                    <TextBlock Text="MIC SENSITIVITY" FontSize="10" Foreground="#8B93A1" />
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding MicSensitivityLabel}" Foreground="#A7AFBC" FontSize="11"
                                 MinWidth="34" VerticalAlignment="Center" />
                      <Slider Minimum="1" Maximum="4" Value="{Binding MicSensitivity}" Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>

                  <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedDevice}"
                            Background="#181C24" Foreground="#ECEEF2" BorderBrush="#3C4350"
                            CornerRadius="6" Padding="8,4" FontSize="11"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="Microphone input device" />

                  <Button Command="{Binding ToggleListeningCommand}"
                          Padding="14,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <Panel>
                      <TextBlock Text="Stop" HorizontalAlignment="Center" IsVisible="{Binding IsListening}" />
                      <TextBlock Text="Start" HorizontalAlignment="Center" IsVisible="{Binding !IsListening}" />
                    </Panel>
                    <Button.Styles>
                      <Style Selector="Button">
                        <Setter Property="Background" Value="#0E4A6E" />
                        <Setter Property="Foreground" Value="White" />
                      </Style>
                      <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="#155E8A" />
                      </Style>
                    </Button.Styles>
                  </Button>
              </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

        </Grid>

    </Grid>

    <!-- BACKGROUNDS PALETTE: swappable media layer (still images + motion loops). Collapsed by
         default in Media mode so the bin has the height. Only Placeholder themes take a live
         background; solid/image themes ignore clicks so no selection ring appears. -->
    <Border Grid.Row="2" Background="#12161D" Padding="14,6" BorderBrush="#2A303C" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Top" Classes="ghost" Command="{Binding ToggleBackgroundsSectionCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,2"
                ToolTip.Tip="Show or hide live backgrounds">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="▶" FontSize="10" Foreground="#8A92A0" VerticalAlignment="Center"
                       IsVisible="{Binding !BackgroundsExpanded}" />
            <TextBlock Text="▼" FontSize="10" Foreground="#8A92A0" VerticalAlignment="Center"
                       IsVisible="{Binding BackgroundsExpanded}" />
            <TextBlock Text="BACKGROUNDS" Classes="section" Foreground="#7C6CF6" FontSize="11"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Panel IsVisible="{Binding BackgroundsExpanded}" Margin="0,8,0,0">
          <DockPanel DataContext="{Binding Backgrounds}">
            <StackPanel DockPanel.Dock="Left" Width="120" VerticalAlignment="Center" Spacing="6">
              <Button Content="+ Add media" Click="OnAddBackgroundClicked" Classes="ghost" FontSize="12"
                      Background="#1B202A" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Content="None (theme)" Command="{Binding ClearCommand}" IsEnabled="{Binding HasSelection}"
                      Classes="ghost" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="12,0,0,0">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="op:BackgroundTileViewModel">
                    <Border Classes="bgTile" Classes.selected="{Binding IsSelected}"
                            DoubleTapped="OnBackgroundTileTapped" Tapped="OnBackgroundTileTapped"
                            ToolTip.Tip="{Binding Name}">
                      <Panel>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                        <TextBlock Text="▶ MOTION" Foreground="#8B93A1" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasThumbnail}" />
                        <Border Background="#CC000000" CornerRadius="3" Padding="4,1" Margin="4"
                                HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsVideo}">
                          <TextBlock Text="▶" Foreground="#22C55E" FontSize="10" FontWeight="Bold" />
                        </Border>
                        <Border Background="#B3000000" VerticalAlignment="Bottom" Padding="5,2">
                          <TextBlock Text="{Binding Name}" Foreground="#E6E9EF" FontSize="10"
                                     TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </Border>
                        <Button Content="✕" Click="OnRemoveBackgroundClicked" Classes="ghost"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,1" FontSize="10"
                                Foreground="#F87171" Background="#CC000000" />
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </DockPanel>
    </Border>

    <!-- STATUS BAR -->
    <Border Grid.Row="3" Background="#181C24" Padding="16,7" BorderBrush="#2A303C" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" Foreground="#959DAB" FontSize="12" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- Live state · account · sync — grouped with AI minutes and version so the top bar stays clean. -->
          <Border Background="#232932" CornerRadius="8" Padding="8,3">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                <TextBlock Text="LIVE" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsLive}">
                <Ellipse Width="7" Height="7" Fill="#4B5563" VerticalAlignment="Center" />
                <TextBlock Text="BLANK" Foreground="#6E7682" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="12" Background="#3A414D" VerticalAlignment="Center" />
              <TextBlock Text="{Binding AccountLabel}" Foreground="#C2C8D2" FontSize="11"
                         MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip.Tip="Signed-in organization and branch" />
              <Border Width="1" Height="12" Background="#3A414D" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SyncStatus}" Foreground="#959DAB" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Panel IsVisible="{Binding ShowAiMinutes}">
            <Border Background="#232932" CornerRadius="8" Padding="8,3" IsVisible="{Binding !AiNearLimit}"
                    ToolTip.Tip="AI listening minutes remaining this month">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                <TextBlock Text="{Binding AiMinutesShort}" Foreground="#9BD3B0" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Background="#3A2A12" CornerRadius="8" Padding="8,3" IsVisible="{Binding AiNearLimit}"
                    ToolTip.Tip="AI listening minutes remaining this month">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" />
                <TextBlock Text="{Binding AiMinutesShort}" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Panel>

          <Button Content="Sign out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}"
                  Background="Transparent" Foreground="#F87171" FontSize="11" FontWeight="SemiBold"
                  Padding="8,3" BorderThickness="0" Cursor="Hand"
                  ToolTip.Tip="Sign out of this seat" />

          <Button Command="{Binding CheckForUpdatesCommand}"
                  Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                  ToolTip.Tip="Check for updates">
            <TextBlock Text="{Binding AppVersion}" Foreground="#3C4350" FontSize="11" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- PERSISTENT MEDIA BAR - always visible (any mode) while media is live, so the operator can
         stop/pause it from anywhere (e.g. while preloading scripture in Bible mode). -->
    <Border Grid.Row="4" Background="#1B202A" Padding="14,8" BorderBrush="#3A2230" BorderThickness="0,1,0,0"
            IsVisible="{Binding MediaPlayback.HasAnyLive}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
          <Ellipse Width="9" Height="9" Fill="#F43F5E" VerticalAlignment="Center" />
          <TextBlock Text="MEDIA LIVE" Foreground="#F43F5E" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding MediaPlayback.NowPlaying}" Foreground="#ECEEF2" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#C2C8D2" Margin="12,0"
                   IsVisible="{Binding MediaPlayback.HasVideoLive}">
          <Run Text="{Binding MediaPlayback.PositionText}" /><Run Text=" / " Foreground="#5C6470" /><Run Text="{Binding MediaPlayback.DurationText}" Foreground="#8A93A2" />
        </TextBlock>
        <Button Grid.Column="3" Command="{Binding MediaPlayback.PlayPauseCommand}" Classes="queueBtn iconBtn"
                IsVisible="{Binding MediaPlayback.HasVideoLive}" Padding="12,5" Margin="0,0,8,0"
                ToolTip.Tip="Play / pause the live video">
          <Panel Width="14" Height="14">
            <Path Data="M 3,2 L 3,14 L 13,8 Z" IsVisible="{Binding MediaPlayback.IsPaused}" />
            <Path Data="M 3,2 H 6.5 V 14 H 3 Z M 9.5,2 H 13 V 14 H 9.5 Z" IsVisible="{Binding !MediaPlayback.IsPaused}" />
          </Panel>
        </Button>
        <Button Grid.Column="4" Content="Clear video" Command="{Binding MediaPlayback.ClearAllCommand}"
                Background="#2A1414" Foreground="#F87171" FontWeight="SemiBold" FontSize="12" Padding="14,6"
                ToolTip.Tip="Clear live video on every screen" />
      </Grid>
    </Border>

    <!-- UPDATE TOAST (persistent, blinking) - floats bottom-right over all rows until the user updates. -->
    <Border Grid.RowSpan="5" Classes="updateToast"
            IsVisible="{Binding UpdateAvailable}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,46" Background="#1E2430" CornerRadius="10"
            BorderBrush="#7C6CF6" BorderThickness="1.5" Padding="16,12"
            BoxShadow="0 8 28 0 #80000000">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <Ellipse Width="10" Height="10" Fill="#7C6CF6" VerticalAlignment="Center" />
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="Update available" Foreground="#ECEEF2" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Foreground="#959DAB" FontSize="11">
            <Run Text="LumenCue" /><Run Text=" " /><Run Text="{Binding UpdateVersion}" /><Run Text=" is ready to install" />
          </TextBlock>
        </StackPanel>
        <Button Classes="primary" Content="Update now" Command="{Binding InstallUpdateCommand}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- TRANSIENT MESSAGE TOAST (manual check feedback) - auto-dismisses. -->
    <Border Grid.RowSpan="5"
            IsVisible="{Binding HasUpdateMessage}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,46" Background="#1E2430" CornerRadius="10"
            BorderBrush="#2A303C" BorderThickness="1" Padding="16,12"
            BoxShadow="0 8 28 0 #80000000">
      <TextBlock Text="{Binding UpdateMessage}" Foreground="#ECEEF2" FontSize="12" VerticalAlignment="Center" />
    </Border>

    <!-- WARNING TOAST (e.g. a referenced verse/chapter that isn't in the Bible) - auto-dismisses. -->
    <Border Grid.RowSpan="5"
            IsVisible="{Binding HasToast}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,64" Background="#2A2113" CornerRadius="10"
            BorderBrush="#E0A23C" BorderThickness="1.5" Padding="16,12"
            BoxShadow="0 8 28 0 #80000000">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="&#x26A0;" Foreground="#E0A23C" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ToastMessage}" Foreground="#F4E4C2" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- UPGRADE PROMPT (reusable paywall dialog) — shown for trial/feature/usage upsell. -->
    <Border Grid.RowSpan="5" ZIndex="100" Background="#B3000000"
            IsVisible="{Binding IsUpgradePromptOpen}">
      <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#171B22" CornerRadius="14" BorderBrush="#2A303C" BorderThickness="1"
              Padding="26" BoxShadow="0 18 60 0 #99000000">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="34" Height="34" CornerRadius="9">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#7C6CF6" Offset="0" />
                  <GradientStop Color="#F472B6" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="&#9733;" FontSize="17" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding UpgradePromptTitle}" Foreground="#ECEEF2" FontSize="17"
                       FontWeight="Bold" VerticalAlignment="Center" MaxWidth="350" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="{Binding UpgradePromptMessage}" Foreground="#B6BDC9" FontSize="13"
                     TextWrapping="Wrap" LineHeight="20" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="ghost" Content="Maybe later" Padding="14,8" FontSize="13"
                    Command="{Binding DismissUpgradePromptCommand}" />
            <Button Content="See plans" Padding="16,8" FontSize="13" FontWeight="SemiBold"
                    Background="#A78BFA" Foreground="White" CornerRadius="8"
                    Command="{Binding OpenCheckoutCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- SHORTCUT CHEATSHEET — session overlay; ? toggles, Esc hides without blanking. -->
    <Border Grid.RowSpan="5" ZIndex="90" Background="#B3000000"
            IsVisible="{Binding ShowShortcutCheatsheet}">
      <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#171B22" CornerRadius="14" BorderBrush="#2A303C" BorderThickness="1"
              Padding="22" BoxShadow="0 18 60 0 #99000000">
        <StackPanel Spacing="14">
          <TextBlock Text="Keyboard shortcuts" Foreground="#ECEEF2" FontSize="18" FontWeight="Bold" />
          <ItemsControl ItemsSource="{x:Static svc:OperatorShortcutChrome.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="svc:ShortcutRow">
                <Grid ColumnDefinitions="120,*" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Text="{Binding KeyLabel}" Foreground="#A78BFA"
                             FontFamily="Menlo, Consolas, monospace" FontSize="13" />
                  <TextBlock Grid.Column="1" Text="{Binding ActionLabel}" Foreground="#C2C8D2" FontSize="13" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Press ? or Esc to hide" Foreground="#8B93A1" FontSize="12" />
        </StackPanel>
      </Border>
    </Border>

    <!-- WHAT'S NEW — shown once after the app updates to a new version. -->
    <Border Grid.RowSpan="5" ZIndex="100" Background="#B3000000"
            IsVisible="{Binding IsWhatsNewOpen}">
      <Border Width="480" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#171B22" CornerRadius="14" BorderBrush="#2A303C" BorderThickness="1"
              Padding="26" BoxShadow="0 18 60 0 #99000000">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="38" Height="38" CornerRadius="10">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#7C6CF6" Offset="0" />
                  <GradientStop Color="#38BDF8" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="&#10024;" FontSize="18" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding WhatsNewTitle}" Foreground="#ECEEF2" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="Thanks for updating LumenCue" Foreground="#8B93A1" FontSize="12" />
            </StackPanel>
          </StackPanel>

          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding WhatsNewItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                    <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Background="#7C6CF6"
                            VerticalAlignment="Top" Margin="2,7,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#C2C8D2" FontSize="13"
                               TextWrapping="Wrap" LineHeight="20" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Button Content="Got it" HorizontalAlignment="Right" Padding="18,8" FontSize="13" FontWeight="SemiBold"
                  Background="#7C6CF6" Foreground="White" CornerRadius="8"
                  Command="{Binding DismissWhatsNewCommand}" />
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
