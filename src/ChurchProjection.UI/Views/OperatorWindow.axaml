<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChurchProjection.UI.ViewModels"
        xmlns:views="using:ChurchProjection.UI.Views"
        xmlns:content="using:ChurchProjection.Core.Models.Content"
        xmlns:svc="using:ChurchProjection.Core.Services"
        xmlns:op="using:ChurchProjection.UI.ViewModels.Operator"
        xmlns:slides="using:ChurchProjection.Core.Models.Slides"
        xmlns:proj="using:ChurchProjection.Core.Models.Projection"
        xmlns:uisvc="using:ChurchProjection.UI.Services"
        x:Class="ChurchProjection.UI.Views.OperatorWindow"
        x:DataType="vm:OperatorViewModel"
        Title="LumenCue"
        Icon="/Assets/app-icon.png"
        Width="1400" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#0E1014">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#181C24" />
      <Setter Property="Foreground" Value="#ECEEF2" />
      <Setter Property="BorderBrush" Value="#3C4350" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#7C6CF6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C6CF6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#6A59E8" />
    </Style>
    <Style Selector="Button.transition">
      <Setter Property="Background" Value="#7C6CF6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.transition:pointerover">
      <Setter Property="Background" Value="#6A59E8" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A7AFBC" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#232932" />
    </Style>
    <!-- Prominent, centered top-bar navigation (Songs / Themes) -->
    <Style Selector="Button.topNav">
      <Setter Property="Background" Value="#1B202A" />
      <Setter Property="BorderBrush" Value="#2A303C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.topNav:pointerover">
      <Setter Property="Background" Value="#262446" />
      <Setter Property="BorderBrush" Value="#7C6CF6" />
    </Style>
    <Style Selector="Button.queueBtn">
      <Setter Property="Background" Value="#2A303C" />
      <Setter Property="Foreground" Value="#D8DCE3" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.queueBtn:pointerover">
      <Setter Property="Background" Value="#3C4350" />
    </Style>
    <!-- Background palette tile -->
    <Style Selector="Border.bgTile">
      <Setter Property="Width" Value="118" />
      <Setter Property="Height" Value="66" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Black" />
      <Setter Property="BorderBrush" Value="#2A303C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.bgTile:pointerover">
      <Setter Property="BorderBrush" Value="#5A6478" />
    </Style>
    <Style Selector="Border.bgTile.selected">
      <Setter Property="BorderBrush" Value="#22C55E" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- Layers status indicator: one dot per compositing layer (lit = on) -->
    <Style Selector="Border.layerDot">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="#2E3540" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.layerDot.on">
      <Setter Property="Background" Value="#34D399" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="#11151B" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="#7C6CF6" />
    </Style>
    <!-- Persistent update toast: gently pulses to stay noticeable until the user updates. -->
    <Style Selector="Border.updateToast">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

    <!-- TOP TOOLBAR (doubles as the window title bar; right inset clears the OS caption buttons) -->
    <!-- Three zones layered in one cell so the center nav is truly window-centered regardless of
         how wide the left (identity/status) and right (controls) clusters are. -->
    <Border Grid.Row="0" Background="#14181F" Padding="16,9,148,9" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
      <Grid>
        <!-- LEFT: identity + live status + session -->
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" ClipToBounds="True">
            <Image Source="/Assets/logo.png" Width="28" Height="28" Stretch="UniformToFill" />
          </Border>
          <TextBlock Classes="h2" Text="LumenCue" Foreground="#ECEEF2" FontSize="16" VerticalAlignment="Center"
                     Margin="0,0,4,0" />
          <Border Background="#22C55E" CornerRadius="10" Padding="10,4" IsVisible="{Binding IsLive}">
            <TextBlock Text="LIVE" Foreground="White" FontSize="11" FontWeight="Bold" />
          </Border>
          <Border Background="#232932" CornerRadius="10" Padding="10,4" IsVisible="{Binding !IsLive}">
            <TextBlock Text="BLANK" Foreground="#6E7682" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Border Background="#232932" CornerRadius="10" Padding="10,4">
            <TextBlock Text="{Binding SyncStatus}" Foreground="#959DAB" FontSize="11" />
          </Border>
          <Border Background="#232932" CornerRadius="10" Padding="10,4"
                  ToolTip.Tip="Signed-in organization and branch">
            <TextBlock Text="{Binding AccountLabel}" Foreground="#C2C8D2" FontSize="11"
                       MaxWidth="240" TextTrimming="CharacterEllipsis" />
          </Border>
        </StackPanel>

        <!-- CENTER: workspace modes — a service is either showing scripture or singing -->
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- Bible mode -->
          <Panel>
            <Button Classes="topNav" Command="{Binding ShowBibleModeCommand}"
                    ToolTip.Tip="Scripture mode: search verses, AI suggestions and bookmarks">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="7" Background="#11324A">
                  <TextBlock Text="&#10013;" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Bible" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Height="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="8,0,8,-1"
                    Background="#38BDF8" IsVisible="{Binding IsBibleMode}" />
          </Panel>
          <!-- Songs mode -->
          <Panel>
            <Button Classes="topNav" Command="{Binding ShowSongsModeCommand}"
                    ToolTip.Tip="Songs mode: smart lyric search and your song library">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="7" Background="#2A2444">
                  <TextBlock Text="&#9835;" FontSize="15" FontWeight="Bold" Foreground="#A78BFA"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Songs" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Height="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="8,0,8,-1"
                    Background="#A78BFA" IsVisible="{Binding IsSongsMode}" />
          </Panel>
          <!-- Media mode: graphics + videos with transport, sent live per channel -->
          <Panel>
            <Button Classes="topNav" Command="{Binding ShowMediaModeCommand}"
                    ToolTip.Tip="Media: send full-screen / lower-third graphics and videos (with sound) per channel">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="7" Background="#0E3A40">
                  <TextBlock Text="&#9658;" FontSize="13" FontWeight="Bold" Foreground="#22D3EE"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Media" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Height="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="8,0,8,-1"
                    Background="#22D3EE" IsVisible="{Binding IsMediaMode}" />
          </Panel>
          <!-- Themes (opens the Theme Studio dialog) -->
          <Button Classes="topNav" Tapped="OnThemeStudioClicked"
                  ToolTip.Tip="Design themes and assign them to scripture / songs / announcements">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <Border Width="26" Height="26" CornerRadius="7">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#7C6CF6" Offset="0" />
                    <GradientStop Color="#F472B6" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <TextBlock Text="Themes" FontSize="14" FontWeight="Bold" Foreground="#ECEEF2" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- RIGHT: operational controls -->
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="ghost" Content="Pre-service" Tapped="OnPreServiceClicked" Padding="10,6" FontSize="12"
                  ToolTip.Tip="Put a live countdown or clock on the screen before the service starts" />
          <Button Classes="ghost" Content="Settings" Tapped="OnSettingsClicked" Padding="10,6" FontSize="12" />
          <Button Classes="ghost" Content="Sign out" Command="{Binding SignOutCommand}" Padding="10,6" FontSize="12"
                  ToolTip.Tip="Release this device's seat and return to the sign-in screen" />
          <Button Classes="ghost" Command="{Binding ToggleScreenOutputCommand}" FontSize="12" Padding="10,6"
                  ToolTip.Tip="Turn the projector screen output on/off. When off, the physical screen reverts to the desktop / another source — different from Blank, which keeps the feed live but shows black.">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ScreenOutputEnabled}">
                <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center" />
                <TextBlock Text="Output On" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !ScreenOutputEnabled}">
                <Ellipse Width="9" Height="9" Fill="#6E7682" VerticalAlignment="Center" />
                <TextBlock Text="Output Off" Foreground="#959DAB" VerticalAlignment="Center" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="danger" Content="Blank" Command="{Binding BlankCommand}" FontSize="12" Padding="12,6" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- MAIN: Playlists (left rail) | AI / Content (center, the hero) | Program + Queue (right rail)  (drag splitters to resize) -->
    <Grid Grid.Row="1" ColumnDefinitions="230,6,*,6,360" Margin="14,12,14,8">

        <!-- LEFT SIDEBAR: ProPresenter-style navigator — collapsible Library + Playlists sections -->
        <Border Grid.Column="0" Background="#181C24" CornerRadius="10" BorderBrush="#2A303C" BorderThickness="1" ClipToBounds="True">
          <Border.Styles>
            <!-- Section header row -->
            <Style Selector="Border.sectionHeader">
              <Setter Property="Background" Value="#1B202A" />
              <Setter Property="Padding" Value="12,7" />
            </Style>
            <Style Selector="TextBlock.sectionLabel">
              <Setter Property="FontSize" Value="10" />
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="Foreground" Value="#8A92A0" />
              <Setter Property="LetterSpacing" Value="1.2" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.hdrIcon">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="#8A92A0" />
              <Setter Property="Padding" Value="5,2" />
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.hdrIcon:pointerover">
              <Setter Property="Background" Value="#2A303C" />
              <Setter Property="Foreground" Value="#ECEEF2" />
            </Style>
            <Style Selector="ListBox.navList">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            </Style>
            <Style Selector="ListBox.navList ListBoxItem">
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="CornerRadius" Value="6" />
              <Setter Property="Margin" Value="4,1" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style Selector="ListBox.navList ListBoxItem:selected">
              <Setter Property="Background" Value="#262446" />
            </Style>
            <Style Selector="ListBox.navList ListBoxItem:pointerover">
              <Setter Property="Background" Value="#232932" />
            </Style>
          </Border.Styles>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

              <!-- ── BOOKMARKS (Bible mode) ──────────────────────────────── -->
              <StackPanel IsVisible="{Binding IsBibleMode}">
                <Border Classes="sectionHeader">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="sectionLabel" Text="BOOKMARKS" />
                    <TextBlock Grid.Column="1" Text="&#9733;" FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <TextBlock IsVisible="{Binding !Transcription.HasBookmarks}"
                           Text="No bookmarks yet — star a verse to pin it here"
                           Foreground="#5B626E" FontSize="11" Margin="14,8" TextWrapping="Wrap" />
                <ListBox Classes="navList" ItemsSource="{Binding Transcription.Bookmarks}"
                         DoubleTapped="OnBookmarksDoubleTapped" IsVisible="{Binding Transcription.HasBookmarks}">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="content:SuggestionItem">
                      <Grid ColumnDefinitions="Auto,*" Background="Transparent"
                            ToolTip.Tip="Double-click to send live · right-click to remove">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Send to Live" Click="OnSendBookmarkToLiveMenu" />
                            <MenuItem Header="Remove Bookmark" Click="OnRemoveBookmarkMenu" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Panel Grid.Column="0" Margin="0,0,9,0">
                          <Border Background="#3A2A12" CornerRadius="5" Width="22" Height="22"
                                  VerticalAlignment="Center" IsVisible="{Binding !IsLive}">
                            <TextBlock Text="&#9733;" FontSize="11" Foreground="#F59E0B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Background="#22C55E" CornerRadius="5" Width="22" Height="22"
                                  VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                            <Ellipse Width="6" Height="6" Fill="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding Title}" Foreground="#E6E9EE" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <Border Background="#22C55E" CornerRadius="3" Padding="4,1"
                                    VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                              <TextBlock Text="LIVE" Foreground="White" FontSize="7" FontWeight="Bold" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Body}" Foreground="#6E7682" FontSize="11"
                                     TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

              <!-- ── LIBRARY (Songs mode) ────────────────────────────────── -->
              <StackPanel IsVisible="{Binding IsSongsMode}">
              <Border Classes="sectionHeader">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="sectionLabel" Text="LIBRARY" />
                  <Button Grid.Column="1" Classes="hdrIcon" Content="&#43;" Tapped="OnNewSongClicked"
                          ToolTip.Tip="Add a song: paste lyrics, auto-detect verses &amp; chorus, preview and save" />
                  <Button Grid.Column="2" Classes="hdrIcon" Command="{Binding ToggleLibrarySectionCommand}"
                          ToolTip.Tip="Collapse / expand">
                    <Panel>
                      <TextBlock Text="&#9662;" FontSize="9" IsVisible="{Binding LibraryExpanded}" />
                      <TextBlock Text="&#9656;" FontSize="9" IsVisible="{Binding !LibraryExpanded}" />
                    </Panel>
                  </Button>
                </Grid>
              </Border>

              <StackPanel IsVisible="{Binding LibraryExpanded}">
                <TextBlock IsVisible="{Binding !HasLibrarySongs}" Text="No songs yet — tap + to import"
                           Foreground="#5B626E" FontSize="11" Margin="14,8" TextWrapping="Wrap" />
                <ListBox x:Name="LibraryListBox" Classes="navList"
                         ItemsSource="{Binding LibrarySongs}" SelectedItem="{Binding SelectedLibrarySong}"
                         DoubleTapped="OnLibrarySongDoubleTapped" IsVisible="{Binding HasLibrarySongs}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="content:Song">
                      <Grid ColumnDefinitions="Auto,*" Background="Transparent"
                            ToolTip.Tip="Double-click to open in Now Singing · right-click to send live / edit">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Send to Live" Click="OnSongSendLiveMenu" />
                            <MenuItem Header="Add to Service Queue" Click="OnSongAddToQueueLibraryMenu" />
                            <Separator />
                            <MenuItem Header="Edit Song" Click="OnEditSongMenu" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Border Grid.Column="0" Background="#3A2A12" CornerRadius="5" Width="22" Height="22"
                                VerticalAlignment="Center" Margin="0,0,9,0">
                          <TextBlock Text="&#9835;" FontSize="11" Foreground="#F59E0B"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" Foreground="#E6E9EE" FontSize="13"
                                     TextTrimming="CharacterEllipsis" MaxLines="1" />
                          <TextBlock Text="{Binding Artist}" Foreground="#6E7682" FontSize="11"
                                     TextTrimming="CharacterEllipsis" MaxLines="1"
                                     IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              </StackPanel>

              <!-- ── PLAYLISTS ───────────────────────────────────────────── -->
              <Border Classes="sectionHeader" Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="sectionLabel" Text="PLAYLISTS" />
                  <Button Grid.Column="1" Classes="hdrIcon" Content="&#43;" Command="{Binding BeginNamePlaylistCommand}"
                          ToolTip.Tip="Save the current Service Queue as a playlist" />
                  <Button Grid.Column="2" Classes="hdrIcon" Command="{Binding TogglePlaylistsSectionCommand}"
                          ToolTip.Tip="Collapse / expand">
                    <Panel>
                      <TextBlock Text="&#9662;" FontSize="9" IsVisible="{Binding PlaylistsExpanded}" />
                      <TextBlock Text="&#9656;" FontSize="9" IsVisible="{Binding !PlaylistsExpanded}" />
                    </Panel>
                  </Button>
                </Grid>
              </Border>

              <StackPanel IsVisible="{Binding PlaylistsExpanded}">
                <!-- Inline "name your playlist" row (toggled by the + button) -->
                <Border IsVisible="{Binding IsNamingPlaylist}" Padding="8,8" Background="#14181F">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding NewPlaylistName}" Watermark="Name this set…" FontSize="12" Padding="8,6" />
                    <Button Classes="primary" Content="Save current queue" Command="{Binding SavePlaylistCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="0,7" />
                  </StackPanel>
                </Border>

                <TextBlock IsVisible="{Binding !HasPlaylists}" Text="No playlists yet — build a queue, then tap + to save it"
                           Foreground="#5B626E" FontSize="11" Margin="14,8" TextWrapping="Wrap" />

                <ListBox x:Name="PlaylistsListBox" Classes="navList"
                         ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                         Tapped="OnPlaylistTapped" IsVisible="{Binding HasPlaylists}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="slides:SavedPlaylist">
                      <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent"
                            ToolTip.Tip="Click to load this set into the Service Queue">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Load into Queue" Click="OnLoadPlaylistMenu" />
                            <MenuItem Header="Delete Playlist" Click="OnDeletePlaylistMenu" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Border Grid.Column="0" Background="#262446" CornerRadius="5" Width="22" Height="22"
                                VerticalAlignment="Center" Margin="0,0,9,0">
                          <TextBlock Text="&#9776;" FontSize="11" Foreground="#A78BFA"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Foreground="#E6E9EE" FontSize="13"
                                     TextTrimming="CharacterEllipsis" MaxLines="1" />
                          <TextBlock Text="{Binding CountLabel}" Foreground="#6E7682" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnDeletePlaylistButton" Background="Transparent" BorderThickness="0"
                                Padding="6,2" Foreground="#5B626E" FontSize="12" Content="&#10005;"
                                ToolTip.Tip="Delete playlist" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Splitter: sidebar <-> center -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" VerticalAlignment="Stretch" />

        <!-- CENTER: AI / CONTENT (search + tabs + lists) — the core of the app -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding IsContentMode}">

          <!-- Single search bar: scripture lookup in Bible mode, smart lyric search in Songs mode.
               Typing in Songs mode drives the Songs results tab (see OperatorViewModel). -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsBibleMode}">
              <TextBox Text="{Binding ContentSearch.SearchQuery}"
                       Watermark="{Binding SearchWatermark}" FontSize="13" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ContentSearch.AvailableTranslations}"
                        SelectedItem="{Binding ContentSearch.SelectedTranslation}"
                        Background="#181C24" Foreground="#ECEEF2" BorderBrush="#3C4350"
                        CornerRadius="6" Padding="10,6" FontSize="12" FontWeight="SemiBold"
                        Margin="6,0,0,0" MinWidth="80"
                        ToolTip.Tip="Bible translation" />
            </Grid>
            <TextBox Grid.Column="0" Text="{Binding SongSearch.Query}"
                     Watermark="{Binding SearchWatermark}" FontSize="13"
                     IsVisible="{Binding IsSongsMode}" />
            <Button Grid.Column="1" Classes="ghost" Content="+ Import Song" Tapped="OnImportSongClicked"
                    Margin="6,0,0,0" IsVisible="{Binding IsSongsMode}" />
          </Grid>

          <!-- Tab bar: Library / AI Suggestions -->
          <Border Grid.Row="1" Background="#181C24" CornerRadius="10" BorderBrush="#2A303C" BorderThickness="1">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#1B202A" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <!-- Shared content tab: "Scripture" (reference lookups) in Bible mode, "Library" in Songs mode -->
                  <Panel>
                    <Button Command="{Binding ShowLibraryTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <Panel>
                        <TextBlock Text="{Binding LibraryTabLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                   IsVisible="{Binding IsLibraryTab}" />
                        <TextBlock Text="{Binding LibraryTabLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                   IsVisible="{Binding !IsLibraryTab}" />
                      </Panel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#7C6CF6"
                            IsVisible="{Binding IsLibraryTab}" />
                  </Panel>
                  <!-- AI Suggestions tab (Bible mode) -->
                  <Panel IsVisible="{Binding IsBibleMode}">
                    <Button Command="{Binding ShowSuggestionsTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel>
                          <TextBlock Text="AI Suggestions" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                     IsVisible="{Binding IsSuggestionsTab}" />
                          <TextBlock Text="AI Suggestions" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                     IsVisible="{Binding !IsSuggestionsTab}" />
                        </Panel>
                        <Border Background="#A78BFA" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                IsVisible="{Binding HasNewSuggestions}">
                          <TextBlock Text="{Binding AiSuggestionCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <Border Background="#232932" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                IsVisible="{Binding !HasNewSuggestions}">
                          <TextBlock Text="{Binding AiSuggestionCount}" Foreground="#959DAB" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </StackPanel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#A78BFA"
                            IsVisible="{Binding IsSuggestionsTab}" />
                  </Panel>
                  <!-- Find Scripture (topical) tab (Bible mode) -->
                  <Panel IsVisible="{Binding IsBibleMode}">
                    <Button Command="{Binding ShowTopicalTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel>
                          <TextBlock Text="Find Scripture" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                     IsVisible="{Binding IsTopicalTab}" />
                          <TextBlock Text="Find Scripture" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                     IsVisible="{Binding !IsTopicalTab}" />
                        </Panel>
                        <Border Background="#38BDF8" CornerRadius="10" Padding="7,2" VerticalAlignment="Center"
                                IsVisible="{Binding HasNewTopical}">
                          <TextBlock Text="!" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </StackPanel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#38BDF8"
                            IsVisible="{Binding IsTopicalTab}" />
                  </Panel>
                  <!-- Songs (lyric search) tab (Songs mode) -->
                  <Panel IsVisible="{Binding IsSongsMode}">
                    <Button Command="{Binding ShowSongsTabCommand}" Padding="16,10" CornerRadius="0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                      <Panel>
                        <TextBlock Text="Songs" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2"
                                   IsVisible="{Binding IsSongsTab}" />
                        <TextBlock Text="Songs" FontSize="13" FontWeight="SemiBold" Foreground="#6E7682"
                                   IsVisible="{Binding !IsSongsTab}" />
                      </Panel>
                    </Button>
                    <Border Height="2" VerticalAlignment="Bottom" Background="#F472B6"
                            IsVisible="{Binding IsSongsTab}" />
                  </Panel>
                </StackPanel>
              </Border>

              <Panel>
                <!-- Scripture-lookup results (Bible mode, tab 0) — ProPresenter-style grid of slide cards -->
                <ListBox x:Name="ContentListBox"
                         ItemsSource="{Binding ContentSearch.Results}"
                         SelectedItem="{Binding ContentSearch.SelectedItem}"
                         Tapped="OnContentListTapped"
                         DoubleTapped="OnContentListDoubleTapped"
                         Background="Transparent" BorderThickness="0" Padding="8,10"
                         IsVisible="{Binding ShowScriptureList}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="6" />
                      <Setter Property="CornerRadius" Value="8" />
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="MinHeight" Value="0" />
                    </Style>
                    <Style Selector="ListBoxItem:selected Border#scrCard">
                      <Setter Property="BorderBrush" Value="#7C6CF6" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Border#scrCard">
                      <Setter Property="BorderBrush" Value="#4B5563" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="content:ContentItem">
                      <Panel Width="210">
                        <Border x:Name="scrCard" Background="#0B0D12" CornerRadius="8"
                                ClipToBounds="True" BorderBrush="#2A303C" BorderThickness="2" Cursor="Hand"
                                ToolTip.Tip="Click to preview · double-click to send live">
                          <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Send to Live" Click="OnSendContentToLiveMenu" />
                              <MenuItem Header="Bookmark Verse" Click="OnBookmarkScriptureMenu"
                                        IsVisible="{Binding IsScripture}" />
                              <MenuItem Header="Show Full Chapter" Click="OnShowFullChapterFromContent"
                                        IsVisible="{Binding IsScripture}" />
                            </ContextMenu>
                          </Border.ContextMenu>
                          <StackPanel>
                            <!-- 16:9 slide preview of the verse text -->
                            <Border Height="118" Background="#000000" Padding="14">
                              <TextBlock Text="{Binding Body}" Foreground="#F4F6FA" FontWeight="SemiBold" FontSize="13"
                                         TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            </Border>
                            <!-- ProPresenter-style label bar: reference + translation/type -->
                            <Border Background="#7C6CF6" Padding="9,5">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White" FontWeight="Bold"
                                           FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Grid.Column="1" Text="{Binding Tag}" Foreground="#E6E1FF" FontWeight="SemiBold"
                                           FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                              </Grid>
                            </Border>
                          </StackPanel>
                        </Border>
                        <!-- Live ring: shows which scripture card is currently on output -->
                        <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                BorderBrush="#22C55E" BorderThickness="3" CornerRadius="8" />
                        <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                Background="#22C55E" CornerRadius="6" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold" />
                          </StackPanel>
                        </Border>
                        <!-- Origin highlight: the verse the operator opened this chapter from (e.g. an AI
                             suggestion). Amber so it never reads as LIVE; sits top-right, clear of the LIVE badge. -->
                        <Border IsVisible="{Binding IsOrigin}" IsHitTestVisible="False"
                                BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="8" />
                        <Border IsVisible="{Binding IsOrigin}" IsHitTestVisible="False"
                                Background="#F59E0B" CornerRadius="6" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                ToolTip.Tip="The verse you opened this chapter from">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="★" Foreground="#1A1205" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="FROM HERE" Foreground="#1A1205" FontSize="9" FontWeight="Bold" />
                          </StackPanel>
                        </Border>
                      </Panel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- Now Singing (Songs mode, tab 0): the opened song's slides; double-click one to project it -->
                <DockPanel IsVisible="{Binding ShowNowSinging}">
                  <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="#2A303C" BorderThickness="0,0,0,1"
                          IsVisible="{Binding HasNowSinging}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NowSingingTitle}" Foreground="#ECEEF2" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="Double-click a slide to send it live · ← → step live · right-click for options"
                                     Foreground="#6E7682" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding FollowStatus}" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold"
                                     VerticalAlignment="Center" IsVisible="{Binding IsFollowOn}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Lyric follow (Assist): highlights/tees up the slide being sung; you still send it -->
                        <ToggleButton IsChecked="{Binding IsFollowOn, Mode=OneWay}" Command="{Binding ToggleFollowCommand}"
                                      FontSize="12" Padding="11,5" CornerRadius="6"
                                      ToolTip.Tip="Lyric Follow (Assist): listens and suggests the slide being sung from THIS song only. You still press send. Requires the mic on.">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#F59E0B"
                                     IsVisible="{Binding IsFollowOn}" />
                            <TextBlock Text="Follow" VerticalAlignment="Center" />
                          </StackPanel>
                        </ToggleButton>
                        <!-- Lines-per-slide quick selector: breaks the song into simpler slides live -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                    ToolTip.Tip="How many lyric lines per slide (0 = auto-fit to theme)">
                          <TextBlock Text="Lines" Foreground="#959DAB" FontSize="11" VerticalAlignment="Center" />
                          <ComboBox ItemsSource="{Binding LinesPerSlideOptions}" SelectedItem="{Binding NowSingingLinesPerSlide}"
                                    FontSize="12" MinWidth="64" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Step the live output through the slides -->
                        <Button Content="◀" FontSize="13" Padding="9,4" CornerRadius="6" Background="#222732" Foreground="#C2C8D2"
                                Click="OnStepLivePrev" ToolTip.Tip="Previous slide live (←)" />
                        <Button Content="▶" FontSize="13" Padding="9,4" CornerRadius="6" Background="#222732" Foreground="#C2C8D2"
                                Click="OnStepLiveNext" ToolTip.Tip="Next slide live (→)" />
                        <Button Content="Blank" FontSize="12" Padding="11,5" CornerRadius="6" Background="#3A1D24" Foreground="#F8B4C0"
                                Command="{Binding BlankCommand}" ToolTip.Tip="Show black on the live output" />
                        <!-- Slide size control: scales the cards so they're easier to read at a distance -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="A" Foreground="#6E7682" FontSize="11" VerticalAlignment="Bottom" />
                          <Slider Width="120" Minimum="0.7" Maximum="2.2" Value="{Binding SlideScale}"
                                  VerticalAlignment="Center" ToolTip.Tip="Resize the slide cards" />
                          <TextBlock Text="A" Foreground="#ECEEF2" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Panel>
                    <StackPanel IsVisible="{Binding !HasNowSinging}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                      <TextBlock Text="&#9835;" FontSize="34" Foreground="#3C4350" HorizontalAlignment="Center" />
                      <TextBlock Text="Pick a song from the Library" Foreground="#6E7682" FontSize="14" HorizontalAlignment="Center" />
                      <TextBlock Text="Double-click a song in the left sidebar to load its slides here"
                                 Foreground="#4B515C" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="NowSingingListBox"
                             ItemsSource="{Binding NowSingingSlides}"
                             SelectedItem="{Binding SelectedNowSingingSlide}"
                             DoubleTapped="OnNowSingingSlideDoubleTapped"
                             KeyDown="OnNowSingingKeyDown"
                             IsVisible="{Binding HasNowSinging}"
                             Background="Transparent" BorderThickness="0" Padding="8,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="6" />
                          <Setter Property="CornerRadius" Value="8" />
                          <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected Border#nowCard">
                          <Setter Property="BorderBrush" Value="#F472B6" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border#nowCard">
                          <Setter Property="BorderBrush" Value="#4B5563" />
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="op:SongSlideItem">
                          <Panel Width="{Binding CardWidth}">
                            <Border x:Name="nowCard" Background="#0B0D12" CornerRadius="8"
                                    ClipToBounds="True" BorderBrush="#2A303C" BorderThickness="2" Cursor="Hand"
                                    ToolTip.Tip="Double-click to send this section live · right-click for options">
                              <Border.ContextFlyout>
                                <MenuFlyout>
                                  <MenuItem Header="Send to live" Click="OnSlideSendLiveMenu" />
                                  <Separator />
                                  <MenuItem Header="Quick edit slide…" Click="OnQuickEditSlideMenu" />
                                  <MenuItem Header="Full edit song…" Click="OnFullEditSongMenu" />
                                </MenuFlyout>
                              </Border.ContextFlyout>
                              <StackPanel>
                                <!-- 16:9 slide preview -->
                                <Border Height="{Binding PreviewHeight}"
                                        Background="#000000" Padding="12">
                                  <TextBlock Text="{Binding Text}" Foreground="#F4F6FA" FontWeight="SemiBold"
                                             FontSize="{Binding TextSize}"
                                             TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <!-- ProPresenter-style label bar (blue=verse, magenta=chorus) -->
                                <Border Background="{Binding BarBrush}" Padding="9,4">
                                  <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold"
                                             FontSize="{Binding LabelSize}"
                                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </Border>
                              </StackPanel>
                            </Border>
                            <!-- Follow ring: lyric-follow's current suggestion (amber, distinct from live green) -->
                            <Border IsVisible="{Binding IsSuggested}" IsHitTestVisible="False"
                                    BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="8" />
                            <Border IsVisible="{Binding IsSuggested}" IsHitTestVisible="False"
                                    Background="#F59E0B" CornerRadius="6" Padding="6,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                              <TextBlock Text="FOLLOW" Foreground="#1A1206" FontSize="9" FontWeight="Bold" />
                            </Border>
                            <!-- Live ring: shows which slide is currently on output -->
                            <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                    BorderBrush="#22C55E" BorderThickness="3" CornerRadius="8" />
                            <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                    Background="#22C55E" CornerRadius="6" Padding="6,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                                <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold" />
                              </StackPanel>
                            </Border>
                          </Panel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Panel>
                </DockPanel>

                <!-- AI Suggestions tab content -->
                <DockPanel IsVisible="{Binding IsSuggestionsTab}">
                  <Border DockPanel.Dock="Top" Padding="12,8" IsVisible="{Binding Transcription.IsListening}">
                    <TextBlock Foreground="#959DAB" FontSize="12" FontStyle="Italic"
                               Text="Listening for scriptures and content..." />
                  </Border>
                  <Border DockPanel.Dock="Top" Padding="12,8" IsVisible="{Binding !Transcription.IsListening}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Foreground="#959DAB" FontSize="12"
                                 Text="AI Listening is off." VerticalAlignment="Center" />
                      <Button Content="Start Listening" FontSize="12" Padding="10,5" CornerRadius="6"
                              Background="#A78BFA" Foreground="White" FontWeight="SemiBold"
                              Command="{Binding Transcription.ToggleListeningCommand}" />
                    </StackPanel>
                  </Border>
                  <ListBox x:Name="SuggestionsListBox"
                           ItemsSource="{Binding Transcription.Suggestions}"
                           SelectedItem="{Binding Transcription.SelectedSuggestion}"
                           Tapped="OnSuggestionsTapped"
                           DoubleTapped="OnSuggestionsDoubleTapped"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="4,1" />
                        <Setter Property="MinHeight" Value="0" />
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#2A2444" />
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#232932" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="content:SuggestionItem">
                        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Send to Live" Click="OnSendSuggestionToLiveMenu" />
                              <MenuItem Header="Bookmark Verse" Click="OnToggleBookmarkMenu"
                                        IsVisible="{Binding !IsBookmarked}" />
                              <MenuItem Header="Remove Bookmark" Click="OnToggleBookmarkMenu"
                                        IsVisible="{Binding IsBookmarked}" />
                              <MenuItem Header="Show Full Chapter" Click="OnShowFullChapterFromSuggestion"
                                        IsVisible="{Binding IsScripture}" />
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <Panel Grid.Column="0" Margin="0,0,10,0">
                            <Border Background="#2A2444" CornerRadius="6" Width="28" Height="28"
                                    VerticalAlignment="Center" IsVisible="{Binding !IsLive}">
                              <TextBlock Text="{Binding Icon}" FontSize="12" FontWeight="Bold" Foreground="#A78BFA"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Background="#22C55E" CornerRadius="6" Width="28" Height="28"
                                    VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                              <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                          </Panel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Title}" Foreground="#ECEEF2" FontSize="13" FontWeight="Medium"
                                         TextTrimming="CharacterEllipsis" MaxLines="1" />
                              <Border Background="#22C55E" CornerRadius="4" Padding="5,1"
                                      VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                                <TextBlock Text="LIVE" Foreground="White" FontSize="8" FontWeight="Bold" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Body}" Foreground="#959DAB" FontSize="12"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Click="OnToggleBookmarkButton" Background="Transparent" BorderThickness="0"
                                    Padding="4,2" CornerRadius="4" ToolTip.Tip="Bookmark verse">
                              <Panel>
                                <TextBlock Text="&#9733;" FontSize="15" Foreground="#F59E0B"
                                           IsVisible="{Binding IsBookmarked}" />
                                <TextBlock Text="&#9734;" FontSize="15" Foreground="#C4B5FD"
                                           IsVisible="{Binding !IsBookmarked}" />
                              </Panel>
                            </Button>
                            <Border Background="#2A2444" CornerRadius="4" Padding="8,3" Margin="2,0">
                              <TextBlock Text="{Binding ScoreDisplay}" Foreground="#A78BFA" FontSize="11" FontWeight="Medium" />
                            </Border>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>

                <!-- Find Scripture (topical) tab content -->
                <DockPanel IsVisible="{Binding IsTopicalTab}">
                 <DockPanel DataContext="{Binding TopicalSearch}">
                  <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="6">
                      <TextBox Text="{Binding Query}" Watermark="Describe a passage, e.g. &quot;go into the nations and preach&quot;"
                               FontSize="13" Padding="8,6" CornerRadius="6" />
                      <TextBlock Text="{Binding StatusText}" Foreground="#959DAB" FontSize="11" FontStyle="Italic" />
                    </StackPanel>
                  </Border>
                  <ListBox x:Name="TopicalListBox"
                           ItemsSource="{Binding Results}"
                           SelectedItem="{Binding SelectedItem}"
                           Tapped="OnTopicalListTapped"
                           DoubleTapped="OnTopicalListDoubleTapped"
                           Background="Transparent" BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="CornerRadius" Value="10" />
                        <Setter Property="Background" Value="Transparent" />
                      </Style>
                      <Style Selector="ListBoxItem:selected Border#slideCard">
                        <Setter Property="BorderBrush" Value="#38BDF8" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="content:ContentItem">
                        <Panel Width="212">
                          <Border x:Name="slideCard" Background="#161A22" CornerRadius="10"
                                  BorderBrush="#2A303C" BorderThickness="2"
                                  ToolTip.Tip="Double-click to send this slide live">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Send to Live" Click="OnSendContentToLiveMenu" />
                                <MenuItem Header="Bookmark Verse" Click="OnBookmarkScriptureMenu"
                                          IsVisible="{Binding IsScripture}" />
                                <MenuItem Header="Show Full Chapter" Click="OnShowFullChapterFromContent"
                                          IsVisible="{Binding IsScripture}" />
                              </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                              <!-- 16:9 slide preview -->
                              <Border Height="118" CornerRadius="8,8,0,0" ClipToBounds="True" Background="#05070B" Padding="12">
                                <TextBlock Text="{Binding Body}" Foreground="#EEF1F6" FontSize="11"
                                           TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                              </Border>
                              <!-- caption -->
                              <Grid ColumnDefinitions="*,Auto" Margin="10,7,10,9">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#ECEEF2" FontSize="12"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#102733" CornerRadius="4" Padding="7,2" Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Tag}" Foreground="#38BDF8" FontSize="9" FontWeight="Medium" />
                                </Border>
                              </Grid>
                            </StackPanel>
                          </Border>
                          <!-- Live ring: shows which scripture card is currently on output -->
                          <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                  BorderBrush="#22C55E" BorderThickness="3" CornerRadius="10" />
                          <Border IsVisible="{Binding IsLive}" IsHitTestVisible="False"
                                  Background="#22C55E" CornerRadius="6" Padding="6,2"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                              <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold" />
                            </StackPanel>
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                 </DockPanel>
                </DockPanel>

                <!-- Songs (smart lyric search) tab content: a results list. "Show full song" opens it
                     in the Now Singing tab, where the slide view lives. -->
                <DockPanel IsVisible="{Binding IsSongsTab}">
                 <DockPanel DataContext="{Binding SongSearch}">
                  <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding StatusText}" Foreground="#959DAB" FontSize="11" FontStyle="Italic" />
                  </Border>
                  <ListBox x:Name="SongSearchListBox"
                           ItemsSource="{Binding Results}"
                           SelectedItem="{Binding SelectedHit}"
                           Tapped="OnSongSearchTapped"
                           DoubleTapped="OnSongSearchDoubleTapped"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="4,1" />
                        <Setter Property="MinHeight" Value="0" />
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#3A1F30" />
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#232932" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="op:SongHitViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent"
                              ToolTip.Tip="Double-click (or “Show full song”) to open it in Now Singing">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Show Full Song" Click="OnSongShowLyricsMenu" />
                              <MenuItem Header="Add Whole Song to Queue" Click="OnSongAddToQueueMenu" />
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <Border Grid.Column="0" Background="#3A1F30" CornerRadius="6" Width="28" Height="28"
                                  VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="&#9835;" FontSize="13" FontWeight="Bold" Foreground="#F472B6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="#ECEEF2" FontSize="13" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{Binding Snippet}" Foreground="#959DAB" FontSize="12" FontStyle="Italic"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2" Background="#3A1F30" CornerRadius="4" Padding="8,3"
                                  VerticalAlignment="Center" Margin="6,0"
                                  IsVisible="{Binding HasMatchedLabel}">
                            <TextBlock Text="{Binding MatchedLabel}" Foreground="#F472B6" FontSize="10" FontWeight="Medium" />
                          </Border>
                          <Button Grid.Column="3" Classes="ghost" Click="OnShowFullSong" VerticalAlignment="Center"
                                  Padding="10,5" Margin="4,0,0,0" ToolTip.Tip="Open in Now Singing">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Text="Show full song" FontSize="12" VerticalAlignment="Center" />
                              <TextBlock Text="&#9662;" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                 </DockPanel>
                </DockPanel>

              </Panel>
            </DockPanel>
          </Border>

        </Grid>

        <!-- CENTER (Media mode): the media bin + transport, swapped in for the content tabs -->
        <Border Grid.Column="2" IsVisible="{Binding IsMediaMode}"
                Background="#181C24" CornerRadius="10" BorderBrush="#2A303C" BorderThickness="1">
          <DockPanel DataContext="{Binding MediaPlayback}">

            <!-- Toolbar: send-to screen, audio out, add, stop -->
            <Border DockPanel.Dock="Top" Background="#1B202A" Padding="12,9" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Send to" Foreground="#959DAB" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                <ComboBox Grid.Column="1" MinWidth="130" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                          FontSize="12" ToolTip.Tip="Which screen this media plays on — All screens, or just one">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="op:MediaTargetOption">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Text="&#9834; Audio" Foreground="#959DAB" FontSize="12" VerticalAlignment="Center" />
                  <ComboBox MinWidth="170" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                            FontSize="12" ToolTip.Tip="Where video sound is sent">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="uisvc:AudioOutputOption">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <Button Content="+ Add media" Click="OnAddMediaClicked" Classes="ghost" FontSize="12" Padding="10,6" />
                  <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding HasLiveOnTarget}"
                          Foreground="#F87171" FontWeight="SemiBold" FontSize="12" Padding="12,6"
                          ToolTip.Tip="Clear media from the selected screen" />
                  <Button Content="Clear all" Command="{Binding ClearAllCommand}" IsEnabled="{Binding HasAnyLive}"
                          Background="#2A1414" Foreground="#F87171" FontWeight="SemiBold" FontSize="12" Padding="12,6"
                          ToolTip.Tip="Immediately remove media from every screen" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Transport bar (shown while a video is live on the selected channel) -->
            <Border DockPanel.Dock="Bottom" Background="#14181F" Padding="12,9" BorderBrush="#2A303C" BorderThickness="0,1,0,0"
                    IsVisible="{Binding HasVideoLive}">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Content="&#9194;" Command="{Binding SkipBackCommand}" Classes="queueBtn"
                        FontSize="13" Padding="9,5" ToolTip.Tip="Back 10s" />
                <Button Grid.Column="1" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Classes="queueBtn"
                        FontSize="13" Padding="11,5" ToolTip.Tip="Play / pause" />
                <Button Grid.Column="2" Content="&#9193;" Command="{Binding SkipForwardCommand}" Classes="queueBtn"
                        FontSize="13" Padding="9,5" ToolTip.Tip="Forward 10s" />

                <Slider Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding PositionFraction}"
                        VerticalAlignment="Center" Margin="6,0" ToolTip.Tip="Scrub" />

                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="#C2C8D2">
                  <Run Text="{Binding PositionText}" /><Run Text=" / " Foreground="#5C6470" /><Run Text="{Binding DurationText}" Foreground="#8A93A2" />
                </TextBlock>

                <TextBlock Grid.Column="5" Text="&#128266;" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0" />
                <Slider Grid.Column="6" Width="100" Minimum="0" Maximum="100" Value="{Binding Volume}"
                        VerticalAlignment="Center" ToolTip.Tip="Volume" />
              </Grid>
            </Border>

            <!-- Media bin -->
            <ScrollViewer Padding="10" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="op:MediaTileViewModel">
                    <Border Width="200" Height="128" Margin="6" CornerRadius="10" ClipToBounds="True"
                            Background="#161A22" BorderBrush="#2A303C" BorderThickness="1"
                            Tapped="OnMediaTileTapped" ContextRequested="OnMediaTileContextRequested" Cursor="Hand">
                      <Panel>
                        <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}" Stretch="UniformToFill" />
                        <Border IsVisible="{Binding !HasThumbnail}" Background="#10131A">
                          <TextBlock Text="&#9654;" FontSize="26" Foreground="#5B6472"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border IsVisible="{Binding IsVideo}" Background="#CC111418" CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                          <TextBlock Text="&#9834; VIDEO" FontSize="10" Foreground="#C2C8D2" />
                        </Border>

                        <Border IsVisible="{Binding IsLive}" BorderBrush="#F43F5E" BorderThickness="3" CornerRadius="9" />
                        <Border IsVisible="{Binding IsLiveAnywhere}" Background="#F43F5E" CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7">
                          <TextBlock Text="{Binding LiveOn}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>

                        <Border VerticalAlignment="Bottom" Background="#CC0B0D12" Padding="8,5">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#ECEEF2" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="&#10005;" Tapped="OnRemoveMediaTile" FontSize="11"
                                    Background="Transparent" Foreground="#8A93A2" Padding="6,1"
                                    ToolTip.Tip="Remove from library" />
                          </Grid>
                        </Border>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Splitter: content <-> right rail -->
        <GridSplitter Grid.Column="3" ResizeDirection="Columns" VerticalAlignment="Stretch" />

        <!-- RIGHT RAIL: compact Program monitor (top) + Service Queue (below) -->
        <Grid Grid.Column="4" RowDefinitions="210,6,*">

          <!-- PROGRAM (small confidence monitor — what you click goes live here) -->
          <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True" BorderBrush="#22C55E" BorderThickness="2">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#1B202A" Padding="12,7" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Classes="section" Text="PROGRAM" Foreground="#22C55E" FontSize="11" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="#22C55E" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                        VerticalAlignment="Center" IsVisible="{Binding IsLive}">
                  <TextBlock Text="ON AIR" Foreground="White" FontSize="9" FontWeight="Bold" />
                </Border>
                <!-- Quick theme switcher: retargets the live slide type's theme and updates the
                     screen + this preview instantly. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="10,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsVisible="{Binding IsLive}">
                  <TextBlock Text="&#127912;" FontSize="11" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding LiveThemeOptions}" SelectedItem="{Binding LiveThemeName}"
                            MinWidth="120" FontSize="11" Padding="6,2" VerticalAlignment="Center"
                            ToolTip.Tip="Switch the theme for the current slide type (applies live)" />
                </StackPanel>
                <Border Grid.Column="3" Background="#7C6CF6" CornerRadius="4" Padding="8,2" Margin="6,0,0,0"
                        VerticalAlignment="Center" IsVisible="{Binding HasMultipleSlides}"
                        ToolTip.Tip="Arrow keys page through this passage">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="PAGE" Foreground="#C7D2FE" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DeckPositionText}" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="#14181F" Padding="10,7" BorderBrush="#2A303C" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="queueBtn" Content="◀" Click="OnPageBack"
                        FontSize="12" Padding="12,6" ToolTip.Tip="Previous page (Left arrow)" />
                <Button Grid.Column="1" Classes="danger" Content="Blank" Command="{Binding BlankCommand}"
                        HorizontalAlignment="Center" Margin="8,0" FontSize="12" Padding="22,6"
                        ToolTip.Tip="Clear the screen to black (Esc)" />
                <Button Grid.Column="2" Classes="queueBtn" Content="▶" Click="OnPageForward"
                        FontSize="12" Padding="12,6" ToolTip.Tip="Next page (Right arrow)" />
              </Grid>
            </Border>

            <!-- Letterbox area is painted in the chrome color (not black) so the uniform-scaled
                 thumbnail blends seamlessly at any window size — no black bars, ProPresenter-style. -->
            <Panel Background="#14181F">
              <!-- True-to-output thumbnail: the actual ProjectorView, scaled to fit, so the preview
                   shows the live theme (background, fonts, colors) exactly as it appears on screen. -->
              <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" ClipToBounds="True">
                  <views:ProjectorView DataContext="{Binding ProgramPreview}" />
                </Border>
              </Viewbox>
              <StackPanel IsVisible="{Binding !IsLive}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                          IsHitTestVisible="False">
                <TextBlock Text="Screen is blank" Foreground="#6E7682" FontSize="13" HorizontalAlignment="Center" />
                <TextBlock Text="Click any item to go live" Foreground="#4B515C" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>

              <!-- Layer status: a read-out of what's currently composited on the output, top → bottom. -->
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,6"
                      Background="#B30B0D12" CornerRadius="7" IsHitTestVisible="False">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Classes="layerDot" Classes.on="{Binding ProgramPreview.ShowAnnouncement}" />
                    <TextBlock Text="Media" FontSize="10" Foreground="#C7CDD8" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Classes="layerDot" Classes.on="{Binding ProgramPreview.ShowSlide}" />
                    <TextBlock Text="Text" FontSize="10" Foreground="#C7CDD8" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Classes="layerDot" Classes.on="{Binding ProgramPreview.BackgroundLayerEnabled}" />
                    <TextBlock Text="Background" FontSize="10" Foreground="#C7CDD8" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Panel>
          </DockPanel>
          </Border>

          <!-- Splitter: program <-> queue -->
          <GridSplitter Grid.Row="1" ResizeDirection="Rows" HorizontalAlignment="Stretch" />

          <!-- Service Queue -->
          <Grid Grid.Row="2">
          <Border Background="#181C24" CornerRadius="10" BorderBrush="#2A303C" BorderThickness="1">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="#2A303C" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="section" Text="SERVICE QUEUE" Foreground="#F59E0B" FontSize="11" />
                    <TextBlock Text="{Binding ServiceQueue.PositionText}" Foreground="#959DAB" FontSize="12" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="+ Add" Command="{Binding AddToQueueCommand}"
                            ToolTip.Tip="Add selected to queue (Q)" FontSize="12" Padding="8,5" />
                    <Button Classes="ghost" Content="+ All" Command="{Binding AddAllToQueueCommand}"
                            ToolTip.Tip="Add all results to queue" FontSize="12" Padding="8,5" />
                    <Button Classes="ghost" Content="Clear" Command="{Binding ServiceQueue.ClearCommand}"
                            ToolTip.Tip="Clear queue" FontSize="12" Padding="8,5" Foreground="#F87171" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border DockPanel.Dock="Bottom" Padding="12,10" BorderBrush="#2A303C" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button Grid.Column="0" Classes="queueBtn" Content="Prev" Command="{Binding ServiceQueue.PrevCommand}"
                          FontSize="12" Padding="12,7" />
                  <Button Grid.Column="1" Classes="transition" Content="Go Live" Command="{Binding ServiceQueue.GoLiveCommand}"
                          HorizontalAlignment="Stretch" Margin="8,0" FontSize="13" Padding="0,9"
                          HorizontalContentAlignment="Center" />
                  <Button Grid.Column="2" Classes="queueBtn" Content="Next" Command="{Binding ServiceQueue.NextCommand}"
                          FontSize="12" Padding="12,7" />
                </Grid>
              </Border>

              <ListBox ItemsSource="{Binding ServiceQueue.Items}"
                       SelectedItem="{Binding ServiceQueue.SelectedItem}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Margin" Value="4,1" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                  <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="#2A2510" />
                  </Style>
                  <Style Selector="ListBoxItem:pointerover">
                    <Setter Property="Background" Value="#232932" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="slides:QueueSlide">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Grid.Column="0" Background="#2A2510" CornerRadius="6" Width="24" Height="24"
                              VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Icon}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Title}" Foreground="#ECEEF2" FontSize="13" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Text="{Binding Body}" Foreground="#959DAB" FontSize="11"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2" Background="#232932" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tag}" Foreground="#A7AFBC" FontSize="10" FontWeight="Medium" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          </Grid>

        </Grid>

    </Grid>

    <!-- BACKGROUNDS PALETTE: swappable media layer (still images + motion loops). Clicking a tile
         swaps the live background under the text without altering the theme. Key-colour (ATEM) outputs
         keep their chroma fill regardless. -->
    <Border Grid.Row="2" Background="#12161D" Padding="14,8" BorderBrush="#2A303C" BorderThickness="0,1,0,0"
            DataContext="{Binding Backgrounds}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="120" VerticalAlignment="Center" Spacing="6">
          <TextBlock Text="BACKGROUNDS" Classes="section" Foreground="#7C6CF6" FontSize="11" FontWeight="SemiBold" />
          <Button Content="+ Add media" Click="OnAddBackgroundClicked" Classes="ghost" FontSize="12"
                  Background="#1B202A" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="None (theme)" Command="{Binding ClearCommand}" IsEnabled="{Binding HasSelection}"
                  Classes="ghost" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="12,0,0,0">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="op:BackgroundTileViewModel">
                <Border Classes="bgTile" Classes.selected="{Binding IsSelected}"
                        DoubleTapped="OnBackgroundTileTapped" Tapped="OnBackgroundTileTapped"
                        ToolTip.Tip="{Binding Name}">
                  <Panel>
                    <!-- Image thumbnail -->
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                    <!-- Motion / no-thumb placeholder -->
                    <TextBlock Text="▶ MOTION" Foreground="#8B93A1" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasThumbnail}" />
                    <!-- Motion badge -->
                    <Border Background="#CC000000" CornerRadius="3" Padding="4,1" Margin="4"
                            HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsVideo}">
                      <TextBlock Text="▶" Foreground="#22C55E" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <!-- Filename label -->
                    <Border Background="#B3000000" VerticalAlignment="Bottom" Padding="5,2">
                      <TextBlock Text="{Binding Name}" Foreground="#E6E9EF" FontSize="10"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </Border>
                    <!-- Remove -->
                    <Button Content="✕" Click="OnRemoveBackgroundClicked" Classes="ghost"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,1" FontSize="10"
                            Foreground="#F87171" Background="#CC000000" />
                  </Panel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- AI LISTENING BAR (slim; mic, status, last-heard, level, device, start/stop) with an
         expandable live-transcript panel so the operator can see exactly what the AI is hearing -->
    <Border Grid.Row="3" Background="#14181F" Padding="14,7" BorderBrush="#2A303C" BorderThickness="0,1,0,0"
            DataContext="{Binding Transcription}">
      <DockPanel>

      <!-- Expandable live transcript (newest words anchored at the bottom for a real-time feel) -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding ShowTranscript}" Height="118" ClipToBounds="True"
              Background="#0E1014" CornerRadius="8" Margin="0,2,0,9" Padding="14,10"
              BorderBrush="#2A303C" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="LIVE TRANSCRIPT" Classes="section" Foreground="#6E7682" FontSize="10" Margin="0,0,0,6" />
          <TextBlock Grid.Row="1" Text="{Binding RecentTranscript}" Foreground="#C9D2DE" FontSize="14" LineHeight="21"
                     TextWrapping="Wrap" VerticalAlignment="Bottom" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding ToggleTranscriptCommand}" Padding="6,3" FontSize="12"
                  ToolTip.Tip="Show / hide the live transcript">
            <Panel>
              <TextBlock Text="&#9650;" FontSize="10" IsVisible="{Binding !ShowTranscript}" />
              <TextBlock Text="&#9660;" FontSize="10" IsVisible="{Binding ShowTranscript}" />
            </Panel>
          </Button>
          <TextBlock Text="&#127908;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="AI LISTENING" Classes="section" Foreground="#A78BFA" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="1" CornerRadius="4" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center" Background="#232932">
          <TextBlock Text="{Binding StatusText}" Foreground="#A7AFBC" FontSize="11" />
        </Border>

        <TextBlock Grid.Column="2" Text="{Binding LastHeard}" Foreground="#7E8794" FontSize="12" FontStyle="Italic"
                   VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis" MaxLines="1" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0"
                    Width="150" IsVisible="{Binding IsListening}">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding HasSignal}">
            <Ellipse.Fill><SolidColorBrush Color="#22C55E" /></Ellipse.Fill>
          </Ellipse>
          <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding !HasSignal}">
            <Ellipse.Fill><SolidColorBrush Color="#3C4350" /></Ellipse.Fill>
          </Ellipse>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding AudioLevelPercent}" Height="6" Width="110"
                       VerticalAlignment="Center" CornerRadius="3">
            <ProgressBar.Styles>
              <Style Selector="ProgressBar /template/ Border#PART_Indicator">
                <Setter Property="Background" Value="#A78BFA" />
                <Setter Property="CornerRadius" Value="3" />
              </Style>
              <Style Selector="ProgressBar">
                <Setter Property="Background" Value="#232932" />
              </Style>
            </ProgressBar.Styles>
          </ProgressBar>
        </StackPanel>

        <ComboBox Grid.Column="4" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedDevice}"
                  Background="#181C24" Foreground="#ECEEF2" BorderBrush="#3C4350"
                  CornerRadius="6" Padding="8,4" FontSize="11" MinWidth="150" MaxWidth="220" Margin="0,0,8,0"
                  VerticalAlignment="Center" ToolTip.Tip="Microphone input device" />

        <Button Grid.Column="5" Command="{Binding ToggleListeningCommand}"
                Padding="14,6" CornerRadius="6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
          <Panel>
            <TextBlock Text="Stop" IsVisible="{Binding IsListening}" />
            <TextBlock Text="Start" IsVisible="{Binding !IsListening}" />
          </Panel>
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="Background" Value="#A78BFA" />
              <Setter Property="Foreground" Value="White" />
            </Style>
            <Style Selector="Button:pointerover">
              <Setter Property="Background" Value="#8B5CF6" />
            </Style>
          </Button.Styles>
        </Button>
      </Grid>
      </DockPanel>
    </Border>

    <!-- STATUS BAR -->
    <Border Grid.Row="4" Background="#181C24" Padding="16,7" BorderBrush="#2A303C" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" Foreground="#959DAB" FontSize="12" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}"
                Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                ToolTip.Tip="Check for updates">
          <TextBlock Text="{Binding AppVersion}" Foreground="#3C4350" FontSize="11" VerticalAlignment="Center" />
        </Button>
      </Grid>
    </Border>

    <!-- UPDATE TOAST (persistent, blinking) - floats bottom-right over all rows until the user updates. -->
    <Border Grid.RowSpan="5" Classes="updateToast"
            IsVisible="{Binding UpdateAvailable}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,46" Background="#1E2430" CornerRadius="10"
            BorderBrush="#7C6CF6" BorderThickness="1.5" Padding="16,12"
            BoxShadow="0 8 28 0 #80000000">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <Ellipse Width="10" Height="10" Fill="#7C6CF6" VerticalAlignment="Center" />
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="Update available" Foreground="#ECEEF2" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Foreground="#959DAB" FontSize="11">
            <Run Text="LumenCue" /><Run Text=" " /><Run Text="{Binding UpdateVersion}" /><Run Text=" is ready to install" />
          </TextBlock>
        </StackPanel>
        <Button Classes="primary" Content="Update now" Command="{Binding InstallUpdateCommand}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- TRANSIENT MESSAGE TOAST (manual check feedback) - auto-dismisses. -->
    <Border Grid.RowSpan="5"
            IsVisible="{Binding HasUpdateMessage}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,46" Background="#1E2430" CornerRadius="10"
            BorderBrush="#2A303C" BorderThickness="1" Padding="16,12"
            BoxShadow="0 8 28 0 #80000000">
      <TextBlock Text="{Binding UpdateMessage}" Foreground="#ECEEF2" FontSize="12" VerticalAlignment="Center" />
    </Border>

  </Grid>
</Window>
