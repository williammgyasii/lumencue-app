<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChurchProjection.UI.ViewModels"
        xmlns:views="using:ChurchProjection.UI.Views"
        x:Class="ChurchProjection.UI.Views.ProjectorWindow"
        x:DataType="vm:ProjectorViewModel"
        Title="Projector Output"
        Icon="/Assets/logo.png"
        Background="{Binding BackgroundBrush}"
        WindowState="Normal"
        SystemDecorations="None"
        ShowInTaskbar="False">

  <views:ProjectorView />

</Window>
