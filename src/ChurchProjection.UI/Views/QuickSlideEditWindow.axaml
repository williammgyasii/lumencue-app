<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChurchProjection.UI.ViewModels.Operator"
        x:Class="ChurchProjection.UI.Views.QuickSlideEditWindow"
        x:DataType="vm:QuickSlideEditViewModel"
        Title="Quick edit slide"
        Width="560" Height="460"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">

    <!-- header -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="Quick edit slide" Foreground="#ECEEF2" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Heading}" Foreground="#6E7682" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,10" IsVisible="{Binding ShowSectionType}">
      <TextBlock Text="SECTION" Foreground="#7C6CF6" FontSize="11" FontWeight="Bold" />
      <ComboBox ItemsSource="{Binding SectionTypes}" SelectedItem="{Binding SectionType}"
                HorizontalAlignment="Left" Width="200" FontSize="13" />
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock Text="{Binding BodyLabel}" Foreground="#7C6CF6" FontSize="11" FontWeight="Bold" />
      <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap"
               FontSize="14" VerticalAlignment="Stretch" Height="220"
               VerticalContentAlignment="Top" Watermark="Type or paste the words for this slide…" />
    </StackPanel>

    <!-- actions -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}"
              Background="#222732" Foreground="#C2C8D2" Padding="16,8" CornerRadius="6" />
      <Button Content="Save" Command="{Binding SaveCommand}"
              Background="#7C6CF6" Foreground="White" FontWeight="SemiBold" Padding="18,8" CornerRadius="6" />
    </StackPanel>
  </Grid>

</Window>
