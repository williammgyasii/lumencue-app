<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChurchProjection.UI.ViewModels"
             x:Class="ChurchProjection.UI.Views.ThemeStudio.ThemeStudioSidebar"
             x:DataType="vm:ThemeStudioViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.sideHead">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.sideList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.sideList ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.sidePlus">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#2A1F3D" />
      <Setter Property="Foreground" Value="#F9A8D4" />
      <Setter Property="BorderBrush" Value="#F472B6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sidePlus:pointerover">
      <Setter Property="Background" Value="#3D2A4F" />
    </Style>
    <Style Selector="Button.sidePlus.theme">
      <Setter Property="Background" Value="#221A3A" />
      <Setter Property="Foreground" Value="#C4B5FD" />
      <Setter Property="BorderBrush" Value="#7C6CF6" />
    </Style>
    <Style Selector="Button.sidePlus.theme:pointerover">
      <Setter Property="Background" Value="#2E2450" />
    </Style>
    <Style Selector="Button.sideTrash">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#3A2226" />
      <Setter Property="Foreground" Value="#FCA5A5" />
      <Setter Property="BorderBrush" Value="#991B1B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sideTrash:pointerover">
      <Setter Property="Background" Value="#4C2A30" />
    </Style>
    <Style Selector="Button.sideTrash:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="#14181F" />
      <Setter Property="BorderBrush" Value="#2A303C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8" />
    </Style>
  </UserControl.Styles>

  <Border Background="#181C24" BorderBrush="#2A303C" BorderThickness="0,0,1,0" Padding="10,10,10,8">
    <Grid RowDefinitions="Auto,Auto,*">

      <StackPanel Grid.Row="0" Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="THEME" Classes="sideHead" Foreground="#A78BFA" />
          <Button Grid.Column="1" Classes="sidePlus theme" Content="+"
                  ToolTip.Tip="New theme">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="New theme" Command="{Binding NewThemeCommand}" />
                <MenuItem Header="Duplicate" Command="{Binding DuplicateThemeCommand}" />
                <MenuItem Header="Import design…" Click="OnImportDesignClicked"
                          IsEnabled="{Binding CanImportDesign}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <ComboBox Grid.Column="0" ItemsSource="{Binding ThemeNames}"
                    SelectedItem="{Binding SelectedThemeName}"
                    VerticalAlignment="Center" Margin="0,0,6,0"
                    ToolTip.Tip="The theme you are editing" />
          <Button Grid.Column="1" Classes="sideTrash" Content="&#128465;"
                  Command="{Binding DeleteThemeCommand}"
                  IsEnabled="{Binding CanDeleteTheme}"
                  ToolTip.Tip="Delete this theme" />
        </Grid>
      </StackPanel>

      <StackPanel Grid.Row="1" Spacing="4" Margin="0,14,0,0">
        <TextBlock Text="PREVIEW AS" Classes="sideHead" Foreground="#22D3EE" />
        <ComboBox ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding PreviewMode}" />
      </StackPanel>

      <Border Grid.Row="2" Classes="bubble" Margin="0,14,0,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,0,8">
            <TextBlock Grid.Column="0" Text="LAYERS" Classes="sideHead" Foreground="#F472B6" />
            <Button Grid.Column="1" Classes="sidePlus" Content="+"
                    ToolTip.Tip="Add a text layer or shape">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Title layer" Command="{Binding AddTextLayerCommand}"
                            CommandParameter="{x:Static vm:RegionKind.Title}"
                            IsEnabled="{Binding CanAddTitleLayer}" />
                  <MenuItem Header="Body layer" Command="{Binding AddTextLayerCommand}"
                            CommandParameter="{x:Static vm:RegionKind.Body}"
                            IsEnabled="{Binding CanAddBodyLayer}" />
                  <MenuItem Header="Footer layer" Command="{Binding AddTextLayerCommand}"
                            CommandParameter="{x:Static vm:RegionKind.Footer}"
                            IsEnabled="{Binding CanAddFooterLayer}" />
                  <Separator />
                  <MenuItem Header="Rectangle" Command="{Binding AddShapeCommand}" />
                  <MenuItem Header="Bar" Command="{Binding AddBarCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ListBox Classes="sideList" ItemsSource="{Binding LayoutObjects}"
                     SelectedItem="{Binding SelectedObject}"
                     ToolTip.Tip="Double-click a shape to rename it">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LayoutObjectItem">
                  <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent"
                              DoubleTapped="OnObjectDoubleTapped">
                    <Border Width="16" Height="16" CornerRadius="3" Background="#2A1F3D"
                            BorderBrush="#7C6CF6" BorderThickness="1" VerticalAlignment="Center"
                            IsVisible="{Binding !IsShape}" />
                    <Border Width="16" Height="5" CornerRadius="2" Background="#F472B6" VerticalAlignment="Center"
                            IsVisible="{Binding IsShape}" />
                    <TextBlock Text="{Binding Display}" Foreground="#D6DAE2" FontSize="12" VerticalAlignment="Center"
                               IsVisible="{Binding !IsEditing}" TextTrimming="CharacterEllipsis" />
                    <TextBox Text="{Binding EditName}" IsVisible="{Binding IsEditing}" FontSize="12"
                             MinWidth="0" Padding="3,0" Margin="-2,0,0,0" VerticalAlignment="Center"
                             KeyDown="OnRenameKeyDown" LostFocus="OnRenameCommit" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>
  </Border>
</UserControl>
