<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChurchProjection.UI.ViewModels"
        xmlns:ts="using:ChurchProjection.UI.Views.ThemeStudio"
        x:Class="ChurchProjection.UI.Views.ThemeStudioWindow"
        x:DataType="vm:ThemeStudioViewModel"
        Title="Theme Studio"
        Width="1360" Height="880"
        MinWidth="1180" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014">

  <Window.Styles>
    <Style Selector="TextBlock.lbl">
      <Setter Property="Foreground" Value="#C2C8D2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,8,0,2" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="#7C6CF6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="TextBlock.sectionThemes">
      <Setter Property="Foreground" Value="#A78BFA" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="TextBlock.sectionPreview">
      <Setter Property="Foreground" Value="#22D3EE" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="TextBlock.sectionLayers">
      <Setter Property="Foreground" Value="#F472B6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="Button.tsSave">
      <Setter Property="Background" Value="#7C6CF6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,8" />
    </Style>
    <Style Selector="Button.tsSave:pointerover">
      <Setter Property="Background" Value="#6D5CE6" />
    </Style>
    <Style Selector="Button.tsClose">
      <Setter Property="Background" Value="#2D2234" />
      <Setter Property="Foreground" Value="#F9A8D4" />
      <Setter Property="BorderBrush" Value="#F472B6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.tsClose:pointerover">
      <Setter Property="Background" Value="#3F2D42" />
    </Style>
    <Style Selector="Button.tsAdd">
      <Setter Property="Background" Value="#0E3A40" />
      <Setter Property="Foreground" Value="#22D3EE" />
      <Setter Property="BorderBrush" Value="#155E75" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.tsAdd:pointerover">
      <Setter Property="Background" Value="#134E59" />
    </Style>
    <Style Selector="Button.tsDanger">
      <Setter Property="Background" Value="#3A2226" />
      <Setter Property="Foreground" Value="#FCA5A5" />
      <Setter Property="BorderBrush" Value="#991B1B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.tsDanger:pointerover">
      <Setter Property="Background" Value="#4C2A30" />
    </Style>
    <Style Selector="Button.tsSidebar">
      <Setter Property="Background" Value="#1F2430" />
      <Setter Property="Foreground" Value="#D6DAE2" />
      <Setter Property="BorderBrush" Value="#3A4150" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="Button.tsSidebar.accentNew">
      <Setter Property="BorderBrush" Value="#7C6CF6" />
      <Setter Property="Foreground" Value="#C4B5FD" />
    </Style>
    <Style Selector="Button.tsSidebar.accentImport">
      <Setter Property="BorderBrush" Value="#22D3EE" />
      <Setter Property="Foreground" Value="#67E8F9" />
    </Style>
    <Style Selector="Button.tsSidebar.accentLayer">
      <Setter Property="BorderBrush" Value="#F472B6" />
      <Setter Property="Foreground" Value="#FBCFE8" />
    </Style>
    <Style Selector="Button.tsSidebarDanger">
      <Setter Property="Background" Value="#3A2226" />
      <Setter Property="Foreground" Value="#FCA5A5" />
      <Setter Property="BorderBrush" Value="#7F1D1D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#7C6CF6" />
      <Setter Property="Background" Value="#2A303C" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.regionBox">
      <Setter Property="BorderBrush" Value="#22D3EE" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Background" Value="#180E7490" />
    </Style>
    <Style Selector="Thumb.handle">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="White" CornerRadius="1.5"
                  BorderBrush="#0E7490" BorderThickness="1" BoxShadow="0 1 2 0 #40000000" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Thumb.move">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeAll" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Expander">
      <Setter Property="Background" Value="#14181F" />
      <Setter Property="BorderBrush" Value="#2A303C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- Toolbar -->
    <DockPanel Grid.Row="0">
      <Border DockPanel.Dock="Top" Height="2">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#7C6CF6" Offset="0" />
            <GradientStop Color="#22D3EE" Offset="0.5" />
            <GradientStop Color="#F472B6" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Background="#15181F" BorderBrush="#2A303C" BorderThickness="0,0,0,1" Padding="14,9" ClipToBounds="True">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="tsDanger" Content="Delete" Command="{Binding DeleteSelectedCommand}"
                  ToolTip.Tip="Delete selected shape or text layer (Del)" />

          <!-- Save feedback -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                      IsVisible="{Binding ShowSaveProgress}">
            <ProgressBar IsIndeterminate="True" Width="72" Height="3" VerticalAlignment="Center" />
            <TextBlock Text="Saving…" Foreground="#A78BFA" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Saved ✓" IsVisible="{Binding ShowSaveSuccess}" Foreground="#34D399" FontSize="12"
                     FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />

          <Button Classes="tsSave" Content="Save Theme" Command="{Binding SaveThemeCommand}" />
          <Button Classes="tsClose" Content="Close" Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close Theme Studio" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    Margin="0,0,12,0" MinWidth="0">
          <TextBlock Text="Editing" Foreground="#A78BFA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBox Text="{Binding Name}" MinWidth="160" MaxWidth="260" FontSize="13" FontWeight="SemiBold"
                   HorizontalContentAlignment="Center" TextAlignment="Center"
                   BorderBrush="#5B21B6" />
        </StackPanel>
      </DockPanel>
      </Border>
    </DockPanel>

    <!-- Main columns -->
    <Grid Grid.Row="1" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="180" />
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="400" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <ts:ThemeStudioSidebar Grid.Column="0" DataContext="{Binding}" />
      <ts:ThemeStudioCanvas Grid.Column="1" DataContext="{Binding}" />
      <ts:ThemeStudioInspector Grid.Column="2" DataContext="{Binding}" />
    </Grid>
  </Grid>
</Window>
