<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChurchProjection.UI.ViewModels.Operator"
        x:Class="ChurchProjection.UI.Views.NoteEditWindow"
        x:DataType="vm:NoteEditViewModel"
        Title="Note"
        Width="560" Height="480"
        MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#0E1014">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">

    <!-- header -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="{Binding Heading}" Foreground="#ECEEF2" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="Shown on screen with your Scripture theme."
                 Foreground="#6E7682" FontSize="12" />
    </StackPanel>

    <!-- title -->
    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,10">
      <TextBlock Text="TITLE" Foreground="#7C6CF6" FontSize="11" FontWeight="Bold" />
      <TextBox Text="{Binding NoteTitle}" FontSize="14" Watermark="e.g. Prayer Points" />
    </StackPanel>

    <!-- body -->
    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock Text="BODY (leave a blank line between points to page them separately)"
                 Foreground="#7C6CF6" FontSize="11" FontWeight="Bold" />
      <TextBox Text="{Binding Body}" AcceptsReturn="True" TextWrapping="Wrap"
               FontSize="14" VerticalAlignment="Stretch" Height="200"
               VerticalContentAlignment="Top" Watermark="Type the note to display…" />
    </StackPanel>

    <!-- actions -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}"
              Background="#222732" Foreground="#C2C8D2" Padding="16,8" CornerRadius="6" />
      <Button Content="Save" Command="{Binding SaveCommand}"
              Background="#7C6CF6" Foreground="White" FontWeight="SemiBold" Padding="18,8" CornerRadius="6" />
    </StackPanel>
  </Grid>

</Window>
