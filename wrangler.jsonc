{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumencue-api",
  "account_id": "e23518956f08ff35812d9ab001a39880",
  "main": "workers/api/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "LumenCueApi",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LUMEN_CUE_API",
        "class_name": "LumenCueApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LumenCueApi"]
    }
  ]
}
